diff --git a/plugins/rockchip-hdmirx/CMakeLists.txt b/plugins/rockchip-hdmirx/CMakeLists.txt
new file mode 100644
index 0000000..36b11c3
--- /dev/null
+++ b/plugins/rockchip-hdmirx/CMakeLists.txt
@@ -0,0 +1,32 @@
+cmake_minimum_required(VERSION 3.28...3.30)
+
+option(ENABLE_ROCKCHIP_HDMIRX "Build OBS with Rockchip HDMI input support" ON)
+
+if(NOT ENABLE_ROCKCHIP_HDMIRX)
+  target_disable(rockchip-hdmirx)
+  return()
+endif()
+
+add_library(rockchip-hdmirx MODULE)
+add_library(OBS::rockchip-hdmirx ALIAS rockchip-hdmirx)
+
+target_sources(rockchip-hdmirx PRIVATE hdmirx-edid.h rockchip-hdmirx.c)
+
+find_package(ALSA REQUIRED)
+
+target_link_libraries(rockchip-hdmirx PRIVATE OBS::libobs ALSA::ALSA)
+
+# RGA3 unpacks 10-bit input (NV15/NV20) for the GPU; without librga only 8-bit
+# signals are supported.
+find_package(PkgConfig QUIET)
+if(PKG_CONFIG_FOUND)
+  pkg_check_modules(LIBRGA QUIET IMPORTED_TARGET librga)
+endif()
+if(LIBRGA_FOUND)
+  target_compile_definitions(rockchip-hdmirx PRIVATE HAVE_RGA)
+  target_link_libraries(rockchip-hdmirx PRIVATE PkgConfig::LIBRGA)
+else()
+  message(WARNING "librga not found, Rockchip HDMI input will not support 10-bit signals")
+endif()
+
+set_target_properties_obs(rockchip-hdmirx PROPERTIES FOLDER plugins PREFIX "")
diff --git a/plugins/rockchip-hdmirx/data/hdmirx.effect b/plugins/rockchip-hdmirx/data/hdmirx.effect
new file mode 100644
index 0000000..e41bbe4
--- /dev/null
+++ b/plugins/rockchip-hdmirx/data/hdmirx.effect
@@ -0,0 +1,129 @@
+// Draws rk_hdmirx capture buffers imported as dma-buf textures.
+//   NV12/NV16/NV24: image = Y (R8), image1 = CbCr (R8G8, R = Cb)
+//   BGR3:           image = packed B,G,R bytes as R8 at 3x width
+// The PQ techniques decode HDR10 to linear Rec. 709, 1.0 = SDR white.
+
+uniform float4x4 ViewProj;
+uniform texture2d image;
+uniform texture2d image1;
+
+uniform float4x4 color_matrix;
+uniform float3 color_range_min = {0.0, 0.0, 0.0};
+uniform float3 color_range_max = {1.0, 1.0, 1.0};
+uniform float2 frame_size;
+uniform float maximum_over_sdr_white_nits;
+
+sampler_state def_sampler {
+	Filter   = Linear;
+	AddressU = Clamp;
+	AddressV = Clamp;
+};
+
+struct VertInOut {
+	float4 pos : POSITION;
+	float2 uv  : TEXCOORD0;
+};
+
+VertInOut VSDefault(VertInOut vert_in)
+{
+	VertInOut vert_out;
+	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
+	vert_out.uv  = vert_in.uv;
+	return vert_out;
+}
+
+// From libobs/data/color.effect.
+float st2084_to_linear_channel(float u)
+{
+	float c = pow(abs(u), 1. / 78.84375);
+	return pow(abs(max(c - 0.8359375, 0.) / (18.8515625 - 18.6875 * c)), 1. / 0.1593017578);
+}
+
+float3 rec2020_to_rec709(float3 v)
+{
+	float r = dot(v, float3(1.6604910021084345, -0.58764113878854951, -0.072849863319884883));
+	float g = dot(v, float3(-0.12455047452159074, 1.1328998971259603, -0.0083494226043694768));
+	float b = dot(v, float3(-0.018150763354905303, -0.10057889800800739, 1.1187296613629127));
+	return float3(r, g, b);
+}
+
+float3 pq_to_linear_709(float3 pq)
+{
+	float3 hdr2020 = float3(st2084_to_linear_channel(pq.r), st2084_to_linear_channel(pq.g),
+				st2084_to_linear_channel(pq.b)) * maximum_over_sdr_white_nits;
+	return rec2020_to_rec709(hdr2020);
+}
+
+float3 sample_ycbcr(float2 uv)
+{
+	float y = image.Sample(def_sampler, uv).r;
+	float2 cbcr = image1.Sample(def_sampler, uv).rg;
+	float3 yuv = clamp(float3(y, cbcr), color_range_min, color_range_max);
+	return saturate(mul(float4(yuv, 1.0), color_matrix).rgb);
+}
+
+float3 load_bgr3(float2 uv)
+{
+	int2 xy = int2(min(uv * frame_size, frame_size - 1.0));
+	int x = xy.x * 3;
+	float b = image.Load(int3(x, xy.y, 0)).r;
+	float g = image.Load(int3(x + 1, xy.y, 0)).r;
+	float r = image.Load(int3(x + 2, xy.y, 0)).r;
+	return saturate((float3(r, g, b) - color_range_min) / (color_range_max - color_range_min));
+}
+
+float4 PSYCbCr(VertInOut vert_in) : TARGET
+{
+	return float4(sample_ycbcr(vert_in.uv), 1.0);
+}
+
+float4 PSYCbCrPQ(VertInOut vert_in) : TARGET
+{
+	return float4(pq_to_linear_709(sample_ycbcr(vert_in.uv)), 1.0);
+}
+
+float4 PSBGR3(VertInOut vert_in) : TARGET
+{
+	return float4(load_bgr3(vert_in.uv), 1.0);
+}
+
+float4 PSBGR3PQ(VertInOut vert_in) : TARGET
+{
+	return float4(pq_to_linear_709(load_bgr3(vert_in.uv)), 1.0);
+}
+
+technique YCbCr
+{
+	pass
+	{
+		vertex_shader = VSDefault(vert_in);
+		pixel_shader  = PSYCbCr(vert_in);
+	}
+}
+
+technique YCbCrPQ
+{
+	pass
+	{
+		vertex_shader = VSDefault(vert_in);
+		pixel_shader  = PSYCbCrPQ(vert_in);
+	}
+}
+
+technique BGR3
+{
+	pass
+	{
+		vertex_shader = VSDefault(vert_in);
+		pixel_shader  = PSBGR3(vert_in);
+	}
+}
+
+technique BGR3PQ
+{
+	pass
+	{
+		vertex_shader = VSDefault(vert_in);
+		pixel_shader  = PSBGR3PQ(vert_in);
+	}
+}
