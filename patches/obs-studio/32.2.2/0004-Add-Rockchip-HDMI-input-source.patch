--- /dev/null
+++ b/plugins/rockchip-hdmirx/rockchip-hdmirx.c
@@ -0,0 +1,1985 @@
+/*
+ * Rockchip HDMI input (rk_hdmirx) source.
+ *
+ * The receiver only delivers the pixel format the HDMI source sends (often
+ * YCbCr 4:4:4, which the generic V4L2 source cannot use), so frames are never
+ * copied or converted on the CPU: capture buffers are exported as dma-bufs,
+ * imported as GPU textures once per buffer, and converted to RGB in a shader.
+ *
+ * 10-bit signals arrive packed (NV15/NV20, four samples in five bytes), which
+ * the GPU can't sample. RGA3 unpacks them to NV12/NV16 first, from each capture
+ * buffer into a dma-buf of its own, so the GPU path stays the same.
+ *
+ * HDR10 (PQ) signals are decoded to linear Rec. 709 in the shader and reported
+ * to OBS as an extended-range source, so OBS tone-maps them for SDR output and
+ * passes them through to HDR canvases. With "Decode HDR" off, the PQ-encoded
+ * Rec. 2020 values pass through untouched as an SDR source instead.
+ *
+ * HDMI audio arrives on a separate ALSA card (rockchip,hdmiin). Whenever the
+ * HDMI source re-detects the receiver (cable replug, EDID switch, receiver
+ * reset) the vendor kernel marks an open capture stream as disconnected, and
+ * it only works again after it was closed and reopened. PipeWire doesn't do
+ * that and loops on the error, so the source records the card itself and
+ * reopens it as needed; the package tells WirePlumber to leave the card alone.
+ */
+
+#include <obs-module.h>
+#include <media-io/video-io.h>
+#include <util/dstr.h>
+#include <util/platform.h>
+#include <util/threading.h>
+#include <util/util_uint64.h>
+
+#include <alsa/asoundlib.h>
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <math.h>
+#include <linux/videodev2.h>
+#include <poll.h>
+#include <pthread.h>
+#include <string.h>
+#include <sys/eventfd.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include "hdmirx-edid.h"
+
+#ifdef HAVE_RGA
+#include <linux/dma-heap.h>
+#include <rga/im2d.h>
+#endif
+
+OBS_DECLARE_MODULE()
+OBS_MODULE_USE_DEFAULT_LOCALE("rockchip-hdmirx", "en-US")
+
+MODULE_EXPORT const char *obs_module_description(void)
+{
+	return "Rockchip HDMI input (rk_hdmirx) with zero-copy GPU conversion";
+}
+
+#define blog_s(s, level, msg, ...) blog(level, "[rockchip-hdmirx: '%s'] " msg, obs_source_get_name((s)->source), ##__VA_ARGS__)
+
+#define FOURCC(a, b, c, d) ((uint32_t)(a) | ((uint32_t)(b) << 8) | ((uint32_t)(c) << 16) | ((uint32_t)(d) << 24))
+#define DRM_FORMAT_R8 FOURCC('R', '8', ' ', ' ')
+#define DRM_FORMAT_GR88 FOURCC('G', 'R', '8', '8')
+
+#define MAX_BUFFERS 8
+#define MIN_BUFFERS 4
+/* Ticks a buffer stays out of the queue after it was last drawn, so the GPU
+ * has finished reading it before the receiver writes into it again. */
+#define RETIRE_TICKS 3
+#define NO_FRAME_TIMEOUT_MS 2000
+#define RETRY_MS 1000
+/* Signal lock after a receiver reset takes about 2.5 s. */
+#define RESET_SETTLE_MS 3000
+#define RESET_INTERVAL_NS (30 * 1000000000ULL)
+
+/* Packed 10-bit formats of the vendor kernel, missing from older headers. */
+#ifndef V4L2_PIX_FMT_NV15
+#define V4L2_PIX_FMT_NV15 v4l2_fourcc('N', 'V', '1', '5')
+#endif
+#ifndef V4L2_PIX_FMT_NV20
+#define V4L2_PIX_FMT_NV20 v4l2_fourcc('N', 'V', '2', '0')
+#endif
+
+/* From the vendor kernel's uapi/linux/rk_hdmirx_config.h. The V4L2 format
+ * never reports a transfer function; HDR shows up only in the DRM infoframe. */
+struct rk_hdr_metadata {
+	uint8_t eotf;
+	uint8_t metadata_type;
+	struct {
+		uint16_t x, y;
+	} display_primaries[3], white_point;
+	uint16_t max_display_mastering_luminance;
+	uint16_t min_display_mastering_luminance;
+	uint16_t max_cll;
+	uint16_t max_fall;
+};
+_Static_assert(sizeof(struct rk_hdr_metadata) == 26, "struct hdr_metadata_infoframe layout");
+
+/* From the vendor kernel's include/media/v4l2-controls_rockchip.h. */
+#define RK_V4L2_CID_AUDIO_SAMPLING_RATE (V4L2_CID_USER_BASE + 0x1180)
+#define RK_V4L2_CID_AUDIO_PRESENT (V4L2_CID_USER_BASE + 0x1181)
+
+#define RK_HDMIRX_CMD_SET_AUDIO_STATE _IOW('V', BASE_VIDIOC_PRIVATE + 5, int)
+#define RK_HDMIRX_CMD_SOFT_RESET _IO('V', BASE_VIDIOC_PRIVATE + 6)
+#define RK_HDMIRX_CMD_GET_COLOR_RANGE _IOR('V', BASE_VIDIOC_PRIVATE + 9, int)
+#define RK_HDMIRX_CMD_GET_COLOR_SPACE _IOR('V', BASE_VIDIOC_PRIVATE + 10, int)
+#define RK_HDMIRX_CMD_GET_HDR_METADATA _IOR('V', BASE_VIDIOC_PRIVATE + 18, struct rk_hdr_metadata)
+#define HDMI_EOTF_SMPTE_ST2084 2
+#define RK_HDMIRX_AUDIO_ON 1
+
+/* EDID presets, numbered like the driver's sysfs "edid" attribute; ours from 100. */
+enum edid_mode {
+	EDID_UNCHANGED = 0,
+	EDID_340M = 1,
+	EDID_600M = 2,
+	EDID_HDR = 5,
+	EDID_HIGH_REFRESH = 100,
+	EDID_HIGH_REFRESH_HDR = 101,
+	EDID_CUSTOM = -1, /* something else, e.g. written by another tool */
+};
+
+/* How often the capture thread re-reads the infoframes; sources switch HDR on
+ * and off without changing the timings. */
+#define COLOR_POLL_MS 1000
+
+/* HDMI audio: how often the audio thread re-reads the receiver's audio state,
+ * and how long it waits for samples before reopening the card. The receiver
+ * clocks the I2S, so a stream without an HDMI audio signal never delivers. */
+#define AUDIO_CHECK_MS 1000
+#define AUDIO_STALL_MS 2000
+#define AUDIO_CHANNELS 2
+#define AUDIO_PERIOD_FRAMES 512
+#define AUDIO_PERIODS 8
+
+struct gpu_plane {
+	uint32_t drm_format;
+	enum gs_color_format gs_format;
+	uint32_t width, height, pitch, offset;
+	uint32_t v4l2_plane;
+};
+
+struct hdmirx_layout {
+	uint32_t fourcc;
+	uint32_t width, height;
+	uint32_t v4l2_planes;
+	uint32_t gpu_planes;
+	struct gpu_plane plane[2];
+	const char *technique;
+	const char *technique_pq;
+
+	/* Set when RGA converts the capture buffers before the GPU reads them. */
+	uint32_t gpu_fourcc;
+	uint32_t src_pitch; /* bytes per line of the packed 10-bit capture */
+	size_t gpu_size;    /* size of one converted buffer */
+};
+
+struct hdmirx_buffer {
+	int dmabuf[VIDEO_MAX_PLANES];
+	gs_texture_t *tex[2];
+	int retire_age; /* -1 while queued, displayed or ready */
+
+	int gpu_dmabuf; /* RGA output, -1 when the GPU reads the capture buffer */
+#ifdef HAVE_RGA
+	rga_buffer_handle_t rga_src_handle, rga_dst_handle;
+	rga_buffer_t rga_src, rga_dst;
+#endif
+};
+
+struct hdmirx_source {
+	obs_source_t *source;
+	char *device;
+	enum edid_mode edid_setting; /* preset to keep on the receiver */
+	bool disconnected;           /* by the Disconnect button, UI thread only */
+	bool audio_enabled;          /* setting: record the HDMI-in ALSA card */
+
+	pthread_t audio_thread;
+	bool audio_thread_running;
+	volatile bool audio_stop;
+	int audio_wake_fd;
+
+	pthread_t thread;
+	bool thread_running;
+	volatile bool stop;
+	int wake_fd;
+
+	gs_effect_t *effect;
+
+	/* Everything below is shared between the capture thread, video_tick and
+	 * video_render and protected by mutex. Lock order: graphics, then mutex. */
+	pthread_mutex_t mutex;
+	int fd; /* -1 while not streaming */
+	struct hdmirx_layout layout;
+	struct v4l2_bt_timings timings;
+	struct hdmirx_buffer buffers[MAX_BUFFERS];
+	uint32_t num_buffers;
+	int ready;     /* newest captured buffer, not yet picked up by tick */
+	int displayed; /* buffer drawn by video_render */
+	bool import_failed;
+	float color_matrix[16];
+	float color_range_min[3];
+	float color_range_max[3];
+	enum video_colorspace colorspace;
+	enum video_range_type range;
+	bool pq;          /* the signal is HDR10 */
+	bool decode_pq;   /* setting: decode PQ to linear Rec. 709, else pass it through */
+	uint16_t max_cll; /* content light level from the infoframe, 0 if unknown */
+	uint64_t frames_captured;
+	uint64_t frames_dropped; /* replaced before video_tick picked them up */
+	double rga_ms;           /* average RGA conversion time per frame */
+	double frame_interval;   /* average seconds between captured frames */
+
+	/* Written by the capture thread, read by the properties. */
+	struct dstr last_status;
+	int last_status_level;
+
+	/* Written by the audio thread, read by the properties. */
+	struct dstr audio_status;
+	int audio_status_level;
+	uint32_t audio_rate; /* 0 while not recording */
+	enum edid_mode edid_current; /* EDID the receiver presents, as of the last check */
+
+	/* capture thread only */
+	uint64_t last_reset_ns;
+	bool format_mismatch;
+};
+
+static int xioctl(int fd, unsigned long request, void *arg)
+{
+	int ret;
+	do {
+		ret = ioctl(fd, request, arg);
+	} while (ret < 0 && errno == EINTR);
+	return ret;
+}
+
+static const char *fourcc_name(uint32_t fourcc, char out[5])
+{
+	memcpy(out, &fourcc, 4);
+	out[4] = 0;
+	return out;
+}
+
+static double timings_fps(const struct v4l2_bt_timings *bt)
+{
+	uint64_t total = (uint64_t)V4L2_DV_BT_FRAME_WIDTH(bt) * V4L2_DV_BT_FRAME_HEIGHT(bt);
+	return total ? (double)bt->pixelclock / (double)total : 0.0;
+}
+
+static const char *fourcc_description(uint32_t fourcc)
+{
+	switch (fourcc) {
+	case V4L2_PIX_FMT_NV24:
+		return "YCbCr 4:4:4, 8-bit";
+	case V4L2_PIX_FMT_NV16:
+		return "YCbCr 4:2:2, 8-bit";
+	case V4L2_PIX_FMT_NV12:
+		return "YCbCr 4:2:0, 8-bit";
+	case V4L2_PIX_FMT_BGR24:
+		return "RGB, 8-bit";
+	case V4L2_PIX_FMT_NV20:
+		return "YCbCr 4:2:2, 10-bit";
+	case V4L2_PIX_FMT_NV15:
+		return "YCbCr 4:2:0, 10-bit";
+	default:
+		return NULL;
+	}
+}
+
+/* Log only when the state changes, so a missing signal doesn't flood the log.
+ * An open properties window reloads to show the new state. */
+static void set_status(struct hdmirx_source *s, int level, const char *status)
+{
+	pthread_mutex_lock(&s->mutex);
+	if (s->last_status.array && strcmp(s->last_status.array, status) == 0) {
+		pthread_mutex_unlock(&s->mutex);
+		return;
+	}
+	dstr_copy(&s->last_status, status);
+	s->last_status_level = level;
+	pthread_mutex_unlock(&s->mutex);
+
+	blog_s(s, level, "%s", status);
+	obs_source_update_properties(s->source);
+}
+
+static void make_yuv_layout(struct hdmirx_layout *l, uint32_t fourcc, uint32_t pitch, uint32_t chroma_pitch,
+			    uint32_t chroma_offset, uint32_t chroma_plane)
+{
+	bool full_w = fourcc == V4L2_PIX_FMT_NV24;
+	bool full_h = fourcc != V4L2_PIX_FMT_NV12;
+
+	l->gpu_planes = 2;
+	l->plane[0] = (struct gpu_plane){DRM_FORMAT_R8, GS_R8, l->width, l->height, pitch, 0, 0};
+	l->plane[1] = (struct gpu_plane){
+		.drm_format = DRM_FORMAT_GR88,
+		.gs_format = GS_R8G8,
+		.width = full_w ? l->width : l->width / 2,
+		.height = full_h ? l->height : l->height / 2,
+		.pitch = chroma_pitch,
+		.offset = chroma_offset,
+		.v4l2_plane = chroma_plane,
+	};
+	l->technique = "YCbCr";
+	l->technique_pq = "YCbCrPQ";
+}
+
+static bool make_layout(const struct v4l2_pix_format_mplane *mp, struct hdmirx_layout *l)
+{
+	uint32_t w = mp->width, h = mp->height;
+	uint32_t pitch0 = mp->plane_fmt[0].bytesperline;
+	bool split = mp->num_planes > 1;
+
+	memset(l, 0, sizeof(*l));
+	l->fourcc = mp->pixelformat;
+	l->width = w;
+	l->height = h;
+	l->v4l2_planes = mp->num_planes;
+
+	switch (mp->pixelformat) {
+	case V4L2_PIX_FMT_BGR24:
+		l->gpu_planes = 1;
+		l->plane[0] = (struct gpu_plane){DRM_FORMAT_R8, GS_R8, w * 3, h, pitch0, 0, 0};
+		l->technique = "BGR3";
+		l->technique_pq = "BGR3PQ";
+		return true;
+
+	case V4L2_PIX_FMT_NV12:
+	case V4L2_PIX_FMT_NV16:
+	case V4L2_PIX_FMT_NV24: {
+		bool full_w = mp->pixelformat == V4L2_PIX_FMT_NV24;
+		uint32_t chroma_pitch = split ? mp->plane_fmt[1].bytesperline : (full_w ? pitch0 * 2 : pitch0);
+
+		make_yuv_layout(l, mp->pixelformat, pitch0, chroma_pitch, split ? 0 : pitch0 * h, split ? 1 : 0);
+		return true;
+	}
+
+#ifdef HAVE_RGA
+	/* RGA3 needs the packed 10-bit lines 16-byte aligned (the receiver pads
+	 * them to 64) and an even size; it writes NV12/NV16 with 64-byte lines. */
+	case V4L2_PIX_FMT_NV15:
+	case V4L2_PIX_FMT_NV20: {
+		bool is422 = mp->pixelformat == V4L2_PIX_FMT_NV20;
+		uint32_t pitch = (w + 63) & ~63u;
+
+		if (split || pitch0 % 16 || w % 2 || h % 2) {
+			return false;
+		}
+		l->gpu_fourcc = is422 ? V4L2_PIX_FMT_NV16 : V4L2_PIX_FMT_NV12;
+		l->src_pitch = pitch0;
+		l->gpu_size = (size_t)pitch * (is422 ? h * 2 : h * 3 / 2);
+		make_yuv_layout(l, l->gpu_fourcc, pitch, pitch, pitch * h, 0);
+		return true;
+	}
+#endif
+	}
+	return false;
+}
+
+/* Reads the capture format and whether the signal is HDR10. G_FMT reports the
+ * colorimetry the driver cached at the last infoframe interrupt, so refresh it
+ * from the AVI infoframe first. */
+static bool read_format(int fd, struct v4l2_format *fmt, bool *pq, uint16_t *max_cll)
+{
+	struct rk_hdr_metadata md = {0};
+	int value;
+
+	xioctl(fd, RK_HDMIRX_CMD_GET_COLOR_SPACE, &value);
+	xioctl(fd, RK_HDMIRX_CMD_GET_COLOR_RANGE, &value);
+
+	memset(fmt, 0, sizeof(*fmt));
+	fmt->type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	if (xioctl(fd, VIDIOC_G_FMT, fmt) < 0) {
+		return false;
+	}
+
+	/* Without a DRM infoframe the driver returns whatever was on its stack,
+	 * so only trust PQ together with BT.2020 colorimetry, as HDR10 sends. */
+	*pq = false;
+	*max_cll = 0;
+	if (xioctl(fd, RK_HDMIRX_CMD_GET_HDR_METADATA, &md) == 0 &&
+	    fmt->fmt.pix_mp.colorspace == V4L2_COLORSPACE_BT2020 && md.metadata_type == 0 &&
+	    (md.eotf & 7) == HDMI_EOTF_SMPTE_ST2084) {
+		*pq = true;
+		*max_cll = md.max_cll;
+	}
+	return true;
+}
+
+/* Called with the mutex held. */
+static void set_color_params(struct hdmirx_source *s, const struct v4l2_pix_format_mplane *mp, bool pq,
+			     uint16_t max_cll)
+{
+	bool rgb = mp->pixelformat == V4L2_PIX_FMT_BGR24;
+	enum video_colorspace cs = VIDEO_CS_709;
+	enum video_range_type range;
+
+	switch (mp->ycbcr_enc) {
+	case V4L2_YCBCR_ENC_601:
+	case V4L2_YCBCR_ENC_XV601:
+		cs = VIDEO_CS_601;
+		break;
+	/* Selects the BT.2020 matrix; the shader applies the PQ curve itself. */
+	case V4L2_YCBCR_ENC_BT2020:
+	case V4L2_YCBCR_ENC_BT2020_CONST_LUM:
+		cs = VIDEO_CS_2100_PQ;
+		break;
+	case V4L2_YCBCR_ENC_DEFAULT:
+		cs = mp->height < 720 ? VIDEO_CS_601 : VIDEO_CS_709;
+		break;
+	default:
+		break;
+	}
+
+	if (mp->quantization == V4L2_QUANTIZATION_FULL_RANGE) {
+		range = VIDEO_RANGE_FULL;
+	} else if (mp->quantization == V4L2_QUANTIZATION_LIM_RANGE) {
+		range = VIDEO_RANGE_PARTIAL;
+	} else {
+		range = rgb ? VIDEO_RANGE_FULL : VIDEO_RANGE_PARTIAL;
+	}
+
+	if (rgb) {
+		float lo = range == VIDEO_RANGE_FULL ? 0.0f : 16.0f / 255.0f;
+		float hi = range == VIDEO_RANGE_FULL ? 1.0f : 235.0f / 255.0f;
+		for (int i = 0; i < 3; i++) {
+			s->color_range_min[i] = lo;
+			s->color_range_max[i] = hi;
+		}
+	} else {
+		video_format_get_parameters_for_format(cs, range, VIDEO_FORMAT_NV12, s->color_matrix,
+						       s->color_range_min, s->color_range_max);
+	}
+	s->colorspace = cs;
+	s->range = range;
+	s->pq = pq;
+	s->max_cll = max_cll;
+}
+
+static bool queue_buffer(int fd, uint32_t index, uint32_t num_planes)
+{
+	struct v4l2_plane planes[VIDEO_MAX_PLANES] = {0};
+	struct v4l2_buffer buf = {
+		.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE,
+		.memory = V4L2_MEMORY_MMAP,
+		.index = index,
+		.m.planes = planes,
+		.length = num_planes,
+	};
+	return xioctl(fd, VIDIOC_QBUF, &buf) == 0;
+}
+
+#ifdef HAVE_RGA
+/* --- RGA (10-bit input) ------------------------------------------------- */
+
+static int alloc_dmabuf(size_t size)
+{
+	static const char *heaps[] = {"/dev/dma_heap/system-uncached", "/dev/dma_heap/system"};
+
+	for (size_t i = 0; i < sizeof(heaps) / sizeof(heaps[0]); i++) {
+		struct dma_heap_allocation_data data = {.len = size, .fd_flags = O_RDWR | O_CLOEXEC};
+		int heap = open(heaps[i], O_RDWR | O_CLOEXEC);
+		if (heap < 0) {
+			continue;
+		}
+		int ret = xioctl(heap, DMA_HEAP_IOCTL_ALLOC, &data);
+		close(heap);
+		if (ret == 0) {
+			return (int)data.fd;
+		}
+	}
+	return -1;
+}
+
+static bool rga_ok(IM_STATUS status)
+{
+	return status == IM_STATUS_SUCCESS || status == IM_STATUS_NOERROR;
+}
+
+static bool rga_buffer_setup(const struct hdmirx_layout *l, struct hdmirx_buffer *b, struct dstr *error)
+{
+	bool is422 = l->fourcc == V4L2_PIX_FMT_NV20;
+	int src_format = is422 ? RK_FORMAT_YCbCr_422_SP_10B : RK_FORMAT_YCbCr_420_SP_10B;
+	int dst_format = is422 ? RK_FORMAT_YCbCr_422_SP : RK_FORMAT_YCbCr_420_SP;
+	uint32_t pitch = l->plane[0].pitch;
+	/* For packed 10-bit formats RGA takes the line stride in bytes. */
+	im_handle_param_t src = {l->src_pitch, l->height, src_format};
+	im_handle_param_t dst = {pitch, l->height, dst_format};
+
+	b->gpu_dmabuf = alloc_dmabuf(l->gpu_size);
+	if (b->gpu_dmabuf < 0) {
+		dstr_printf(error, "Unable to allocate buffers for the RGA output: %s", strerror(errno));
+		return false;
+	}
+	b->rga_src_handle = importbuffer_fd(b->dmabuf[0], &src);
+	b->rga_dst_handle = importbuffer_fd(b->gpu_dmabuf, &dst);
+	if (!b->rga_src_handle || !b->rga_dst_handle) {
+		dstr_copy(error, "Unable to import buffers into RGA");
+		return false;
+	}
+	b->rga_src = wrapbuffer_handle_t(b->rga_src_handle, l->width, l->height, l->src_pitch, l->height, src_format);
+	b->rga_dst = wrapbuffer_handle_t(b->rga_dst_handle, l->width, l->height, pitch, l->height, dst_format);
+	return true;
+}
+
+static void rga_buffer_release(struct hdmirx_buffer *b)
+{
+	if (b->rga_src_handle) {
+		releasebuffer_handle(b->rga_src_handle);
+	}
+	if (b->rga_dst_handle) {
+		releasebuffer_handle(b->rga_dst_handle);
+	}
+	b->rga_src_handle = b->rga_dst_handle = 0;
+	if (b->gpu_dmabuf >= 0) {
+		close(b->gpu_dmabuf);
+	}
+	b->gpu_dmabuf = -1;
+}
+
+static IM_STATUS rga_convert(const struct hdmirx_layout *l, struct hdmirx_buffer *b)
+{
+	im_rect rect = {0, 0, (int)l->width, (int)l->height};
+	im_rect none = {0};
+	rga_buffer_t pat = {0};
+
+	return improcess(b->rga_src, b->rga_dst, pat, rect, rect, none, IM_SYNC);
+}
+#endif
+
+/* --- capture thread ----------------------------------------------------- */
+
+static void stream_teardown(struct hdmirx_source *s)
+{
+	uint64_t captured, dropped;
+	int fd;
+
+	obs_enter_graphics();
+	pthread_mutex_lock(&s->mutex);
+	fd = s->fd;
+	captured = s->frames_captured;
+	dropped = s->frames_dropped;
+	s->frames_captured = s->frames_dropped = 0;
+	for (uint32_t i = 0; i < s->num_buffers; i++) {
+		struct hdmirx_buffer *b = &s->buffers[i];
+		for (int p = 0; p < 2; p++) {
+			gs_texture_destroy(b->tex[p]);
+			b->tex[p] = NULL;
+		}
+		for (int p = 0; p < VIDEO_MAX_PLANES; p++) {
+			if (b->dmabuf[p] >= 0) {
+				close(b->dmabuf[p]);
+			}
+			b->dmabuf[p] = -1;
+		}
+#ifdef HAVE_RGA
+		rga_buffer_release(b);
+#endif
+	}
+	s->fd = -1;
+	s->rga_ms = 0.0;
+	s->frame_interval = 0.0;
+	s->num_buffers = 0;
+	s->ready = s->displayed = -1;
+	s->import_failed = false;
+	memset(&s->layout, 0, sizeof(s->layout));
+	pthread_mutex_unlock(&s->mutex);
+	obs_leave_graphics();
+
+	if (fd >= 0) {
+		int type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+		xioctl(fd, VIDIOC_STREAMOFF, &type);
+		close(fd);
+		blog_s(s, LOG_INFO, "Capture stopped: %" PRIu64 " frames, %" PRIu64 " dropped", captured, dropped);
+	}
+}
+
+static bool query_signal(struct hdmirx_source *s, int fd, struct v4l2_dv_timings *timings)
+{
+	memset(timings, 0, sizeof(*timings));
+	if (xioctl(fd, VIDIOC_QUERY_DV_TIMINGS, timings) == 0) {
+		return true;
+	}
+
+	switch (errno) {
+	case ENOLINK:
+		set_status(s, LOG_INFO, "No HDMI signal");
+		break;
+	case ENOLCK:
+		set_status(s, LOG_INFO, "HDMI signal not locked");
+		break;
+	default:
+		set_status(s, LOG_WARNING, "Unable to query HDMI timings");
+		break;
+	}
+	return false;
+}
+
+/* S_DV_TIMINGS only accepts CEA-861 timings, and that check compares the
+ * sync polarities too. Sources often send standard modes with other polarities
+ * (macOS sends 3840x2160p60 with negative sync), so retry with the others. */
+static bool set_timings(int fd, struct v4l2_dv_timings *timings)
+{
+	uint32_t detected = timings->bt.polarities;
+	static const uint32_t all[] = {
+		V4L2_DV_HSYNC_POS_POL | V4L2_DV_VSYNC_POS_POL,
+		0,
+		V4L2_DV_HSYNC_POS_POL,
+		V4L2_DV_VSYNC_POS_POL,
+	};
+
+	if (xioctl(fd, VIDIOC_S_DV_TIMINGS, timings) == 0) {
+		return true;
+	}
+	for (size_t i = 0; i < sizeof(all) / sizeof(all[0]) && errno == EINVAL; i++) {
+		if (all[i] == detected) {
+			continue;
+		}
+		timings->bt.polarities = all[i];
+		if (xioctl(fd, VIDIOC_S_DV_TIMINGS, timings) == 0) {
+			return true;
+		}
+	}
+	timings->bt.polarities = detected;
+	return false;
+}
+
+static void wait_ms(struct hdmirx_source *s, int ms)
+{
+	struct pollfd pfd = {.fd = s->wake_fd, .events = POLLIN};
+	if (!s->stop) {
+		poll(&pfd, 1, ms);
+	}
+}
+
+static const uint8_t *edid_data(enum edid_mode mode)
+{
+	switch (mode) {
+	case EDID_340M:
+		return edid_340m;
+	case EDID_600M:
+		return edid_600m;
+	case EDID_HDR:
+		return edid_hdr;
+	case EDID_HIGH_REFRESH:
+		return edid_high_refresh;
+	case EDID_HIGH_REFRESH_HDR:
+		return edid_high_refresh_hdr;
+	default:
+		return NULL;
+	}
+}
+
+static const char *edid_name(enum edid_mode mode)
+{
+	switch (mode) {
+	case EDID_340M:
+		return obs_module_text("Edid.340M");
+	case EDID_600M:
+		return obs_module_text("Edid.600M");
+	case EDID_HDR:
+		return obs_module_text("Edid.Hdr");
+	case EDID_HIGH_REFRESH:
+		return obs_module_text("Edid.HighRefresh");
+	case EDID_HIGH_REFRESH_HDR:
+		return obs_module_text("Edid.HighRefreshHdr");
+	case EDID_CUSTOM:
+		return obs_module_text("Edid.Custom");
+	default:
+		return obs_module_text("Edid.Unknown");
+	}
+}
+
+static enum edid_mode read_edid(int fd)
+{
+	static const enum edid_mode modes[] = {EDID_340M, EDID_600M, EDID_HDR, EDID_HIGH_REFRESH,
+					       EDID_HIGH_REFRESH_HDR};
+	uint8_t data[256];
+	struct v4l2_edid edid = {.blocks = 2, .edid = data};
+
+	if (xioctl(fd, VIDIOC_G_EDID, &edid) < 0 || edid.blocks != 2) {
+		return EDID_CUSTOM;
+	}
+	for (size_t i = 0; i < sizeof(modes) / sizeof(modes[0]); i++) {
+		if (memcmp(data, edid_data(modes[i]), sizeof(data)) == 0) {
+			return modes[i];
+		}
+	}
+	return EDID_CUSTOM;
+}
+
+/* Makes the receiver present the EDID chosen in the properties. Writing it
+ * replugs the HDMI source, which then re-reads it; this is done through V4L2
+ * rather than the driver's root-only sysfs attribute. Returns true when it was
+ * changed, so the caller waits for the signal to come back. */
+static bool apply_edid(struct hdmirx_source *s, int fd)
+{
+	enum edid_mode current = read_edid(fd);
+	enum edid_mode wanted = s->edid_setting;
+	struct dstr status = {0};
+	bool changed = false;
+
+	if (wanted != EDID_UNCHANGED && wanted != current) {
+		/* V4L2 copies the EDID back to the caller, so it can't be read-only. */
+		uint8_t data[256];
+		struct v4l2_edid edid = {.blocks = 2, .edid = data};
+		memcpy(data, edid_data(wanted), sizeof(data));
+		if (xioctl(fd, VIDIOC_S_EDID, &edid) == 0) {
+			dstr_printf(&status, "Switching the EDID to %s; the HDMI source re-detects the receiver",
+				    edid_name(wanted));
+			current = wanted;
+			changed = true;
+		} else {
+			dstr_printf(&status, "Unable to set the EDID: %s", strerror(errno));
+		}
+	}
+
+	pthread_mutex_lock(&s->mutex);
+	s->edid_current = current;
+	pthread_mutex_unlock(&s->mutex);
+
+	if (status.len) {
+		set_status(s, changed ? LOG_INFO : LOG_WARNING, status.array);
+	}
+	dstr_free(&status);
+	return changed;
+}
+
+static bool stream_setup(struct hdmirx_source *s)
+{
+	struct v4l2_capability cap = {0};
+	struct v4l2_dv_timings timings;
+	struct v4l2_format fmt = {.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE};
+	struct v4l2_requestbuffers req = {
+		.count = MAX_BUFFERS,
+		.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE,
+		.memory = V4L2_MEMORY_MMAP,
+	};
+	struct v4l2_event_subscription sub = {.type = V4L2_EVENT_SOURCE_CHANGE};
+	struct hdmirx_buffer buffers[MAX_BUFFERS];
+	struct hdmirx_layout layout;
+	struct dstr status = {0};
+	char fourcc[5], fourcc2[5];
+	int type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	int fd;
+
+	if (!s->device || !*s->device) {
+		set_status(s, LOG_WARNING, "No device selected");
+		return false;
+	}
+
+	fd = open(s->device, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+	if (fd < 0) {
+		dstr_printf(&status, "Unable to open %s: %s", s->device, strerror(errno));
+		set_status(s, LOG_WARNING, status.array);
+		dstr_free(&status);
+		return false;
+	}
+
+	if (xioctl(fd, VIDIOC_QUERYCAP, &cap) < 0 || !(cap.device_caps & V4L2_CAP_VIDEO_CAPTURE_MPLANE) ||
+	    !(cap.device_caps & V4L2_CAP_STREAMING)) {
+		set_status(s, LOG_WARNING, "Device is not a multi-planar streaming capture device");
+		goto fail;
+	}
+
+	xioctl(fd, VIDIOC_SUBSCRIBE_EVENT, &sub);
+
+	if (apply_edid(s, fd)) {
+		close(fd);
+		wait_ms(s, RESET_SETTLE_MS);
+		return false;
+	}
+
+	if (!query_signal(s, fd, &timings)) {
+		goto fail;
+	}
+	/* Lock the receiver to the detected timings; G_FMT reflects them after this.
+	 * The driver often has them already (it follows the signal by itself) and
+	 * rejects measured timings that are slightly off the CEA-861 table, so only
+	 * a capture format that doesn't match the signal is an error. */
+	int set_err = set_timings(fd, &timings) ? 0 : errno;
+	bool pq;
+	uint16_t max_cll;
+
+	if (!read_format(fd, &fmt, &pq, &max_cll)) {
+		set_status(s, LOG_WARNING, "Unable to read capture format");
+		goto fail;
+	}
+	if (fmt.fmt.pix_mp.width != timings.bt.width || fmt.fmt.pix_mp.height != timings.bt.height) {
+		dstr_printf(&status, "Capture format %ux%u doesn't match the HDMI signal %ux%u", fmt.fmt.pix_mp.width,
+			    fmt.fmt.pix_mp.height, timings.bt.width, timings.bt.height);
+		if (set_err) {
+			dstr_catf(&status, " (setting the timings failed: %s)", strerror(set_err));
+		}
+		set_status(s, LOG_WARNING, status.array);
+		s->format_mismatch = true;
+		goto fail;
+	}
+	if (!make_layout(&fmt.fmt.pix_mp, &layout)) {
+		dstr_printf(&status, "Unsupported pixel format %s from the HDMI source",
+			    fourcc_name(fmt.fmt.pix_mp.pixelformat, fourcc));
+		set_status(s, LOG_WARNING, status.array);
+		goto fail;
+	}
+
+	if (xioctl(fd, VIDIOC_REQBUFS, &req) < 0 || req.count < MIN_BUFFERS) {
+		dstr_printf(&status, "Unable to allocate capture buffers (%s, got %u)", strerror(errno), req.count);
+		set_status(s, LOG_WARNING, status.array);
+		goto fail;
+	}
+	if (req.count > MAX_BUFFERS) {
+		req.count = MAX_BUFFERS;
+	}
+
+	memset(buffers, 0, sizeof(buffers));
+	for (uint32_t i = 0; i < MAX_BUFFERS; i++) {
+		buffers[i].retire_age = -1;
+		buffers[i].gpu_dmabuf = -1;
+		for (int p = 0; p < VIDEO_MAX_PLANES; p++) {
+			buffers[i].dmabuf[p] = -1;
+		}
+	}
+
+	for (uint32_t i = 0; i < req.count; i++) {
+		for (uint32_t p = 0; p < layout.v4l2_planes; p++) {
+			struct v4l2_exportbuffer exp = {
+				.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE,
+				.index = i,
+				.plane = p,
+				.flags = O_RDONLY | O_CLOEXEC,
+			};
+			if (xioctl(fd, VIDIOC_EXPBUF, &exp) < 0) {
+				set_status(s, LOG_WARNING, "Unable to export capture buffers as dma-buf");
+				goto fail_buffers;
+			}
+			buffers[i].dmabuf[p] = exp.fd;
+		}
+		if (!queue_buffer(fd, i, layout.v4l2_planes)) {
+			set_status(s, LOG_WARNING, "Unable to queue capture buffers");
+			goto fail_buffers;
+		}
+	}
+
+#ifdef HAVE_RGA
+	if (layout.gpu_fourcc) {
+		/* RGA2 can't read packed 10-bit and only reaches the first 4 GB of RAM. */
+		imconfig(IM_CONFIG_SCHEDULER_CORE, IM_SCHEDULER_RGA3_CORE0 | IM_SCHEDULER_RGA3_CORE1);
+		for (uint32_t i = 0; i < req.count; i++) {
+			if (!rga_buffer_setup(&layout, &buffers[i], &status)) {
+				set_status(s, LOG_WARNING, status.array);
+				goto fail_buffers;
+			}
+		}
+		im_rect rect = {0, 0, (int)layout.width, (int)layout.height};
+		im_rect none = {0};
+		rga_buffer_t pat = {0};
+		IM_STATUS check = imcheck_t(buffers[0].rga_src, buffers[0].rga_dst, pat, rect, rect, none, 0);
+		if (!rga_ok(check)) {
+			dstr_printf(&status, "RGA can't convert %s to %s: %s", fourcc_name(layout.fourcc, fourcc),
+				    fourcc_name(layout.gpu_fourcc, fourcc2), imStrError_t(check));
+			set_status(s, LOG_WARNING, status.array);
+			goto fail_buffers;
+		}
+	}
+#endif
+
+	if (xioctl(fd, VIDIOC_STREAMON, &type) < 0) {
+		dstr_printf(&status, "Unable to start streaming: %s", strerror(errno));
+		set_status(s, LOG_WARNING, status.array);
+		goto fail_buffers;
+	}
+
+	pthread_mutex_lock(&s->mutex);
+	s->fd = fd;
+	s->layout = layout;
+	s->timings = timings.bt;
+	memcpy(s->buffers, buffers, sizeof(buffers));
+	s->num_buffers = req.count;
+	s->ready = s->displayed = -1;
+	s->import_failed = false;
+	set_color_params(s, &fmt.fmt.pix_mp, pq, max_cll);
+	pthread_mutex_unlock(&s->mutex);
+
+	{
+		const struct v4l2_bt_timings *bt = &timings.bt;
+		dstr_printf(&status, "Capturing %ux%u%s @ %.2f Hz, %s, %u buffers", layout.width, layout.height,
+			    bt->interlaced ? "i" : "p", timings_fps(bt), fourcc_name(layout.fourcc, fourcc), req.count);
+		if (layout.gpu_fourcc) {
+			dstr_catf(&status, ", converted to %s on RGA3", fourcc_name(layout.gpu_fourcc, fourcc2));
+		}
+		if (pq) {
+			dstr_cat(&status, ", HDR10 (PQ)");
+		}
+		set_status(s, LOG_INFO, status.array);
+	}
+	dstr_free(&status);
+	return true;
+
+fail_buffers:
+	for (uint32_t i = 0; i < MAX_BUFFERS; i++) {
+		for (int p = 0; p < VIDEO_MAX_PLANES; p++) {
+			if (buffers[i].dmabuf[p] >= 0) {
+				close(buffers[i].dmabuf[p]);
+			}
+		}
+#ifdef HAVE_RGA
+		rga_buffer_release(&buffers[i]);
+#endif
+	}
+fail:
+	dstr_free(&status);
+	close(fd);
+	return false;
+}
+
+/* A source-change event is also sent when nothing really changed (e.g. on
+ * stream start), so only restart if the timings or the format differ. */
+static bool signal_changed(struct hdmirx_source *s, int fd)
+{
+	struct v4l2_dv_timings timings = {0};
+	struct v4l2_format fmt = {.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE};
+	const struct v4l2_bt_timings *cur = &s->timings;
+
+	if (xioctl(fd, VIDIOC_QUERY_DV_TIMINGS, &timings) < 0) {
+		return true;
+	}
+	if (timings.bt.width != cur->width || timings.bt.height != cur->height ||
+	    timings.bt.interlaced != cur->interlaced || timings.bt.pixelclock != cur->pixelclock) {
+		return true;
+	}
+	if (xioctl(fd, VIDIOC_G_FMT, &fmt) == 0 && fmt.fmt.pix_mp.pixelformat != s->layout.fourcc) {
+		return true;
+	}
+	return false;
+}
+
+/* Applies colorimetry or HDR changes that keep the timings and the pixel
+ * format. Returns false when the stream has to restart. */
+static bool update_color(struct hdmirx_source *s, int fd)
+{
+	struct v4l2_format fmt;
+	bool pq, changed;
+	uint16_t max_cll;
+
+	if (!read_format(fd, &fmt, &pq, &max_cll)) {
+		return true;
+	}
+	if (fmt.fmt.pix_mp.pixelformat != s->layout.fourcc) {
+		return false;
+	}
+
+	pthread_mutex_lock(&s->mutex);
+	enum video_colorspace cs = s->colorspace;
+	enum video_range_type range = s->range;
+	bool was_pq = s->pq;
+	set_color_params(s, &fmt.fmt.pix_mp, pq, max_cll);
+	changed = cs != s->colorspace || range != s->range || was_pq != s->pq;
+	pthread_mutex_unlock(&s->mutex);
+
+	if (changed) {
+		set_status(s, LOG_INFO, pq ? "HDMI signal switched to HDR10 (PQ)" : "HDMI signal colorimetry changed");
+	}
+	return true;
+}
+
+/* Returns true when the receiver has a signal but stopped delivering frames. */
+static bool stream_run(struct hdmirx_source *s)
+{
+	int fd = s->fd;
+	uint32_t num_planes = s->layout.v4l2_planes;
+	int idle_ms = 0;
+	uint64_t color_checked_ns = os_gettime_ns();
+	double last_timestamp = 0.0;
+
+	while (!s->stop) {
+		uint64_t now = os_gettime_ns();
+		if (now - color_checked_ns >= COLOR_POLL_MS * 1000000ULL) {
+			color_checked_ns = now;
+			if (!update_color(s, fd)) {
+				set_status(s, LOG_INFO, "HDMI signal changed, restarting");
+				return false;
+			}
+		}
+
+		struct pollfd pfd[2] = {
+			{.fd = fd, .events = POLLIN | POLLPRI},
+			{.fd = s->wake_fd, .events = POLLIN},
+		};
+		int ret = poll(pfd, 2, 500);
+
+		if (s->stop) {
+			return false;
+		}
+		if (ret < 0) {
+			if (errno == EINTR) {
+				continue;
+			}
+			return false;
+		}
+		if (ret == 0) {
+			idle_ms += 500;
+			if (idle_ms >= NO_FRAME_TIMEOUT_MS) {
+				return true;
+			}
+			continue;
+		}
+
+		if (pfd[0].revents & POLLPRI) {
+			struct v4l2_event ev;
+			bool changed = false;
+			while (xioctl(fd, VIDIOC_DQEVENT, &ev) == 0) {
+				if (ev.type == V4L2_EVENT_SOURCE_CHANGE) {
+					changed = true;
+				}
+			}
+			if (changed && signal_changed(s, fd)) {
+				set_status(s, LOG_INFO, "HDMI signal changed, restarting");
+				return false;
+			}
+		}
+		if (pfd[0].revents & POLLERR) {
+			return false;
+		}
+
+		if (pfd[0].revents & POLLIN) {
+			struct v4l2_plane planes[VIDEO_MAX_PLANES] = {0};
+			struct v4l2_buffer buf = {
+				.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE,
+				.memory = V4L2_MEMORY_MMAP,
+				.m.planes = planes,
+				.length = num_planes,
+			};
+
+			if (xioctl(fd, VIDIOC_DQBUF, &buf) < 0) {
+				if (errno == EAGAIN) {
+					continue;
+				}
+				return false;
+			}
+			idle_ms = 0;
+
+			double rga_ms = 0.0;
+#ifdef HAVE_RGA
+			if (s->layout.gpu_fourcc && !(buf.flags & V4L2_BUF_FLAG_ERROR)) {
+				uint64_t start = os_gettime_ns();
+				IM_STATUS st = rga_convert(&s->layout, &s->buffers[buf.index]);
+				rga_ms = (double)(os_gettime_ns() - start) / 1e6;
+				if (!rga_ok(st)) {
+					struct dstr status = {0};
+					dstr_printf(&status, "RGA conversion failed: %s", imStrError_t(st));
+					set_status(s, LOG_WARNING, status.array);
+					dstr_free(&status);
+					buf.flags |= V4L2_BUF_FLAG_ERROR;
+				}
+			}
+#endif
+
+			/* The receiver's pixel clock (and so the timings' frame rate) is
+			 * off for some modes, e.g. a quarter for 2160p60 10-bit 4:2:2. */
+			double timestamp = (double)buf.timestamp.tv_sec + (double)buf.timestamp.tv_usec / 1e6;
+			double interval = last_timestamp > 0.0 ? timestamp - last_timestamp : 0.0;
+			last_timestamp = timestamp;
+
+			pthread_mutex_lock(&s->mutex);
+			if (rga_ms > 0.0) {
+				s->rga_ms = s->rga_ms > 0.0 ? s->rga_ms * 0.95 + rga_ms * 0.05 : rga_ms;
+			}
+			if (interval > 0.0 && interval < 1.0) {
+				s->frame_interval = s->frame_interval > 0.0 ? s->frame_interval * 0.95 + interval * 0.05
+									    : interval;
+			}
+			if (buf.flags & V4L2_BUF_FLAG_ERROR) {
+				queue_buffer(fd, buf.index, num_planes);
+			} else {
+				/* Drop the previous frame if tick hasn't picked it up yet. */
+				if (s->ready >= 0) {
+					queue_buffer(fd, s->ready, num_planes);
+					s->frames_dropped++;
+				}
+				s->ready = buf.index;
+				s->frames_captured++;
+			}
+			pthread_mutex_unlock(&s->mutex);
+		}
+	}
+	return false;
+}
+
+/* The vendor driver only reprograms the DMA storage format on hotplug. When the
+ * source switches pixel encoding on the fly (e.g. macOS going from 1080p 4:4:4
+ * to 2160p 4:2:0), the DMA keeps writing the old layout, overruns the buffers
+ * and never completes a frame. A soft reset re-runs the hotplug path. */
+static void reset_receiver(struct hdmirx_source *s)
+{
+	uint64_t now = os_gettime_ns();
+	int fd;
+
+	if (s->last_reset_ns && now - s->last_reset_ns < RESET_INTERVAL_NS) {
+		return;
+	}
+	s->last_reset_ns = now;
+
+	fd = open(s->device, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+	if (fd < 0 || xioctl(fd, RK_HDMIRX_CMD_SOFT_RESET, (void *)1) < 0) {
+		set_status(s, LOG_WARNING, "Unable to reset the HDMI receiver");
+	} else {
+		set_status(s, LOG_INFO, "Resetting the HDMI receiver");
+	}
+	if (fd >= 0) {
+		close(fd);
+	}
+	wait_ms(s, RESET_SETTLE_MS);
+}
+
+static void *capture_thread(void *data)
+{
+	struct hdmirx_source *s = data;
+
+	os_set_thread_name("rockchip-hdmirx");
+
+	while (!s->stop) {
+		s->format_mismatch = false;
+		if (!stream_setup(s)) {
+			if (s->format_mismatch) {
+				reset_receiver(s);
+			}
+			wait_ms(s, RETRY_MS);
+			continue;
+		}
+		bool stalled = stream_run(s);
+		stream_teardown(s);
+		if (stalled && !s->stop) {
+			set_status(s, LOG_INFO, "No frames from the HDMI receiver, restarting");
+			reset_receiver(s);
+		}
+		wait_ms(s, 100);
+	}
+	return NULL;
+}
+
+/* --- HDMI audio --------------------------------------------------------- */
+
+/* Like set_status, for the audio thread. */
+static void set_audio_status(struct hdmirx_source *s, int level, const char *status)
+{
+	pthread_mutex_lock(&s->mutex);
+	if (s->audio_status.array && strcmp(s->audio_status.array, status) == 0) {
+		pthread_mutex_unlock(&s->mutex);
+		return;
+	}
+	dstr_copy(&s->audio_status, status);
+	s->audio_status_level = level;
+	pthread_mutex_unlock(&s->mutex);
+
+	blog_s(s, level, "Audio: %s", status);
+	obs_source_update_properties(s->source);
+}
+
+static void audio_wait_ms(struct hdmirx_source *s, int ms)
+{
+	struct pollfd pfd = {.fd = s->audio_wake_fd, .events = POLLIN};
+	if (!s->audio_stop) {
+		poll(&pfd, 1, ms);
+	}
+}
+
+/* The receiver's audio sample rate, or 0 while the HDMI signal has no audio. */
+static uint32_t read_audio_rate(int vfd)
+{
+	struct v4l2_control present = {.id = RK_V4L2_CID_AUDIO_PRESENT};
+	struct v4l2_control rate = {.id = RK_V4L2_CID_AUDIO_SAMPLING_RATE};
+
+	if (xioctl(vfd, VIDIOC_G_CTRL, &present) < 0 || !present.value || xioctl(vfd, VIDIOC_G_CTRL, &rate) < 0 ||
+	    rate.value < 32000 || rate.value > 192000) {
+		return 0;
+	}
+	return (uint32_t)rate.value;
+}
+
+static bool find_audio_card(char *name, size_t size)
+{
+	int card = -1;
+
+	while (snd_card_next(&card) == 0 && card >= 0) {
+		char *card_name = NULL;
+		bool match = snd_card_get_name(card, &card_name) == 0 && strstr(card_name, "hdmiin");
+		free(card_name);
+		if (match) {
+			snprintf(name, size, "hw:%d,0", card);
+			return true;
+		}
+	}
+	return false;
+}
+
+static snd_pcm_t *open_audio(struct hdmirx_source *s, const char *name, uint32_t rate)
+{
+	snd_pcm_hw_params_t *hw;
+	snd_pcm_sw_params_t *sw;
+	snd_pcm_uframes_t period = AUDIO_PERIOD_FRAMES, buffer = AUDIO_PERIOD_FRAMES * AUDIO_PERIODS;
+	struct dstr status = {0};
+	snd_pcm_t *pcm;
+	int err;
+
+	err = snd_pcm_open(&pcm, name, SND_PCM_STREAM_CAPTURE, SND_PCM_NONBLOCK);
+	if (err < 0) {
+		if (err == -EBUSY) {
+			set_audio_status(s, LOG_WARNING,
+					 "the HDMI audio device is in use by another program, e.g. PipeWire");
+		} else {
+			dstr_printf(&status, "unable to open %s: %s", name, snd_strerror(err));
+			set_audio_status(s, LOG_WARNING, status.array);
+		}
+		dstr_free(&status);
+		return NULL;
+	}
+
+	snd_pcm_hw_params_alloca(&hw);
+	snd_pcm_sw_params_alloca(&sw);
+	if ((err = snd_pcm_hw_params_any(pcm, hw)) < 0 ||
+	    (err = snd_pcm_hw_params_set_access(pcm, hw, SND_PCM_ACCESS_RW_INTERLEAVED)) < 0 ||
+	    (err = snd_pcm_hw_params_set_format(pcm, hw, SND_PCM_FORMAT_S32_LE)) < 0 ||
+	    (err = snd_pcm_hw_params_set_channels(pcm, hw, AUDIO_CHANNELS)) < 0 ||
+	    (err = snd_pcm_hw_params_set_rate(pcm, hw, rate, 0)) < 0 ||
+	    (err = snd_pcm_hw_params_set_period_size_near(pcm, hw, &period, NULL)) < 0 ||
+	    (err = snd_pcm_hw_params_set_buffer_size_near(pcm, hw, &buffer)) < 0 ||
+	    (err = snd_pcm_hw_params(pcm, hw)) < 0 || (err = snd_pcm_sw_params_current(pcm, sw)) < 0 ||
+	    (err = snd_pcm_sw_params_set_avail_min(pcm, sw, period)) < 0 || (err = snd_pcm_sw_params(pcm, sw)) < 0 ||
+	    (err = snd_pcm_start(pcm)) < 0) {
+		dstr_printf(&status, "unable to set up %s for %u Hz: %s", name, rate, snd_strerror(err));
+		set_audio_status(s, LOG_WARNING, status.array);
+		dstr_free(&status);
+		snd_pcm_close(pcm);
+		return NULL;
+	}
+	return pcm;
+}
+
+/* Records until the stream fails, stalls or the receiver's audio changes. */
+static void audio_run(struct hdmirx_source *s, snd_pcm_t *pcm, int vfd, uint32_t rate)
+{
+	int32_t data[AUDIO_PERIOD_FRAMES * AUDIO_CHANNELS];
+	int nfds = snd_pcm_poll_descriptors_count(pcm);
+	struct pollfd pfd[8];
+	uint64_t checked_ns = os_gettime_ns(), data_ns = checked_ns;
+	bool receiving = false;
+
+	if (nfds < 1 || nfds > 7) {
+		return;
+	}
+	snd_pcm_poll_descriptors(pcm, pfd, (unsigned int)nfds);
+	pfd[nfds] = (struct pollfd){.fd = s->audio_wake_fd, .events = POLLIN};
+
+	while (!s->audio_stop) {
+		uint64_t now = os_gettime_ns();
+		if (now - checked_ns >= AUDIO_CHECK_MS * 1000000ULL) {
+			checked_ns = now;
+			if (read_audio_rate(vfd) != rate) {
+				return;
+			}
+		}
+		if (now - data_ns >= AUDIO_STALL_MS * 1000000ULL) {
+			set_audio_status(s, LOG_INFO, "no samples from the HDMI receiver");
+			return;
+		}
+
+		if (poll(pfd, (nfds_t)nfds + 1, 200) < 0 && errno != EINTR) {
+			return;
+		}
+		if (s->audio_stop) {
+			return;
+		}
+
+		snd_pcm_sframes_t frames;
+		while ((frames = snd_pcm_readi(pcm, data, AUDIO_PERIOD_FRAMES)) > 0) {
+			snd_pcm_sframes_t delay = 0;
+			if (snd_pcm_delay(pcm, &delay) < 0 || delay < 0) {
+				delay = 0;
+			}
+			struct obs_source_audio audio = {
+				.data = {(const uint8_t *)data},
+				.frames = (uint32_t)frames,
+				.speakers = SPEAKERS_STEREO,
+				.format = AUDIO_FORMAT_32BIT,
+				.samples_per_sec = rate,
+				/* when the first of these frames was captured */
+				.timestamp = os_gettime_ns() - util_mul_div64((uint64_t)(frames + delay), 1000000000ULL, rate),
+			};
+			obs_source_output_audio(s->source, &audio);
+			data_ns = os_gettime_ns();
+
+			if (!receiving) {
+				struct dstr status = {0};
+				receiving = true;
+				dstr_printf(&status, "recording %u Hz stereo", rate);
+				pthread_mutex_lock(&s->mutex);
+				s->audio_rate = rate;
+				pthread_mutex_unlock(&s->mutex);
+				set_audio_status(s, LOG_INFO, status.array);
+				dstr_free(&status);
+			}
+		}
+
+		if (frames == -EAGAIN) {
+			continue;
+		}
+		if (frames == -EPIPE || frames == -ESTRPIPE) {
+			/* overrun: OBS didn't read for a while, carry on */
+			if (snd_pcm_prepare(pcm) == 0 && snd_pcm_start(pcm) == 0) {
+				continue;
+			}
+		}
+		/* -EBADFD: the kernel disconnected the stream when the HDMI source
+		 * re-detected the receiver; it needs reopening. */
+		struct dstr status = {0};
+		dstr_printf(&status, "stream stopped (%s), reopening", snd_strerror((int)frames));
+		set_audio_status(s, LOG_INFO, status.array);
+		dstr_free(&status);
+		return;
+	}
+}
+
+static void *audio_thread(void *data)
+{
+	struct hdmirx_source *s = data;
+	char name[32];
+	int vfd = -1;
+
+	os_set_thread_name("rockchip-hdmirx-audio");
+
+	while (!s->audio_stop) {
+		if (vfd < 0) {
+			vfd = open(s->device, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+		}
+		if (!find_audio_card(name, sizeof(name))) {
+			set_audio_status(s, LOG_WARNING, "no HDMI-in audio device (rockchip,hdmiin) found");
+			audio_wait_ms(s, RETRY_MS * 5);
+			continue;
+		}
+
+		uint32_t rate = vfd >= 0 ? read_audio_rate(vfd) : 0;
+		if (!rate && vfd >= 0) {
+			/* The driver starts its audio monitor from an interrupt that may
+			 * never come (on an RK3588 with a Mac attached it didn't), and
+			 * then never notices the audio. Start it explicitly; once running
+			 * it reschedules itself until the next hotplug. */
+			int on = RK_HDMIRX_AUDIO_ON;
+			xioctl(vfd, RK_HDMIRX_CMD_SET_AUDIO_STATE, &on);
+			audio_wait_ms(s, AUDIO_CHECK_MS);
+			rate = read_audio_rate(vfd);
+		}
+		if (!rate) {
+			set_audio_status(s, LOG_INFO, "the HDMI signal carries no audio");
+			audio_wait_ms(s, AUDIO_CHECK_MS / 2);
+			continue;
+		}
+
+		snd_pcm_t *pcm = open_audio(s, name, rate);
+		if (pcm) {
+			audio_run(s, pcm, vfd, rate);
+			snd_pcm_close(pcm);
+			pthread_mutex_lock(&s->mutex);
+			s->audio_rate = 0;
+			pthread_mutex_unlock(&s->mutex);
+			audio_wait_ms(s, 200);
+		} else {
+			audio_wait_ms(s, RETRY_MS);
+		}
+	}
+
+	if (vfd >= 0) {
+		close(vfd);
+	}
+	return NULL;
+}
+
+static void stop_audio(struct hdmirx_source *s)
+{
+	if (!s->audio_thread_running) {
+		return;
+	}
+	s->audio_stop = true;
+	uint64_t one = 1;
+	if (write(s->audio_wake_fd, &one, sizeof(one)) < 0) {
+		blog_s(s, LOG_WARNING, "Unable to wake audio thread");
+	}
+	pthread_join(s->audio_thread, NULL);
+	s->audio_thread_running = false;
+
+	uint64_t drain;
+	if (read(s->audio_wake_fd, &drain, sizeof(drain)) < 0 && errno != EAGAIN) {
+		blog_s(s, LOG_WARNING, "Unable to reset audio wake event");
+	}
+}
+
+static void start_audio(struct hdmirx_source *s)
+{
+	if (s->audio_thread_running || !s->device || !*s->device) {
+		return;
+	}
+	s->audio_stop = false;
+	pthread_mutex_lock(&s->mutex);
+	dstr_free(&s->audio_status);
+	s->audio_rate = 0;
+	pthread_mutex_unlock(&s->mutex);
+	if (pthread_create(&s->audio_thread, NULL, audio_thread, s) == 0) {
+		s->audio_thread_running = true;
+	} else {
+		blog_s(s, LOG_ERROR, "Unable to start audio thread");
+	}
+}
+
+/* --- capture thread control --------------------------------------------- */
+
+static void stop_capture(struct hdmirx_source *s)
+{
+	stop_audio(s);
+	if (!s->thread_running) {
+		return;
+	}
+	s->stop = true;
+	uint64_t one = 1;
+	if (write(s->wake_fd, &one, sizeof(one)) < 0) {
+		blog_s(s, LOG_WARNING, "Unable to wake capture thread");
+	}
+	pthread_join(s->thread, NULL);
+	s->thread_running = false;
+
+	uint64_t drain;
+	if (read(s->wake_fd, &drain, sizeof(drain)) < 0 && errno != EAGAIN) {
+		blog_s(s, LOG_WARNING, "Unable to reset wake event");
+	}
+}
+
+static void start_capture(struct hdmirx_source *s)
+{
+	s->stop = false;
+	pthread_mutex_lock(&s->mutex);
+	dstr_free(&s->last_status);
+	pthread_mutex_unlock(&s->mutex);
+	if (pthread_create(&s->thread, NULL, capture_thread, s) == 0) {
+		s->thread_running = true;
+	} else {
+		blog_s(s, LOG_ERROR, "Unable to start capture thread");
+	}
+	if (s->audio_enabled) {
+		start_audio(s);
+	}
+}
+
+/* --- device discovery --------------------------------------------------- */
+
+static bool is_hdmirx(const char *path, struct v4l2_capability *cap)
+{
+	int fd = open(path, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+	bool ok;
+
+	if (fd < 0) {
+		return false;
+	}
+	memset(cap, 0, sizeof(*cap));
+	ok = xioctl(fd, VIDIOC_QUERYCAP, cap) == 0 && strstr((const char *)cap->driver, "hdmirx") &&
+	     (cap->device_caps & V4L2_CAP_VIDEO_CAPTURE_MPLANE);
+	close(fd);
+	return ok;
+}
+
+/* Calls cb for every rk_hdmirx node in /dev, in name order. */
+static void for_each_hdmirx(void (*cb)(void *param, const char *path, const struct v4l2_capability *cap), void *param)
+{
+	struct dirent **list;
+	int n = scandir("/dev", &list, NULL, alphasort);
+
+	for (int i = 0; i < n; i++) {
+		if (strncmp(list[i]->d_name, "video", 5) == 0) {
+			struct v4l2_capability cap;
+			struct dstr path = {0};
+			dstr_printf(&path, "/dev/%s", list[i]->d_name);
+			if (is_hdmirx(path.array, &cap)) {
+				cb(param, path.array, &cap);
+			}
+			dstr_free(&path);
+		}
+		free(list[i]);
+	}
+	if (n > 0) {
+		free(list);
+	}
+}
+
+static void first_device_cb(void *param, const char *path, const struct v4l2_capability *cap)
+{
+	UNUSED_PARAMETER(cap);
+	char **out = param;
+	if (!*out) {
+		*out = bstrdup(path);
+	}
+}
+
+static void list_device_cb(void *param, const char *path, const struct v4l2_capability *cap)
+{
+	struct dstr name = {0};
+	dstr_printf(&name, "%s (%s)", (const char *)cap->card, path);
+	obs_property_list_add_string(param, name.array, path);
+	dstr_free(&name);
+}
+
+/* --- obs_source_info ---------------------------------------------------- */
+
+static const char *hdmirx_get_name(void *unused)
+{
+	UNUSED_PARAMETER(unused);
+	return obs_module_text("RockchipHdmiRx");
+}
+
+static void hdmirx_update(void *data, obs_data_t *settings)
+{
+	struct hdmirx_source *s = data;
+	const char *device = obs_data_get_string(settings, "device");
+	enum edid_mode edid = (enum edid_mode)obs_data_get_int(settings, "edid");
+	char *detected = NULL;
+
+	pthread_mutex_lock(&s->mutex);
+	s->decode_pq = obs_data_get_bool(settings, "decode_hdr");
+	pthread_mutex_unlock(&s->mutex);
+	s->audio_enabled = obs_data_get_bool(settings, "audio");
+
+	if (!*device) {
+		for_each_hdmirx(first_device_cb, &detected);
+		device = detected ? detected : "";
+	}
+	if (s->thread_running && s->device && strcmp(s->device, device) == 0 && s->edid_setting == edid) {
+		bfree(detected);
+		if (s->audio_enabled) {
+			start_audio(s);
+		} else {
+			stop_audio(s);
+		}
+		return;
+	}
+
+	stop_capture(s);
+	s->edid_setting = edid;
+	bfree(s->device);
+	s->device = bstrdup(device);
+	bfree(detected);
+	if (!s->disconnected) {
+		start_capture(s);
+	}
+}
+
+static void hdmirx_defaults(obs_data_t *settings)
+{
+	obs_data_set_default_bool(settings, "decode_hdr", true);
+	obs_data_set_default_bool(settings, "audio", true);
+}
+
+static void *hdmirx_create(obs_data_t *settings, obs_source_t *source)
+{
+	struct hdmirx_source *s = bzalloc(sizeof(*s));
+	char *effect_path;
+
+	s->source = source;
+	s->fd = -1;
+	s->ready = s->displayed = -1;
+	pthread_mutex_init(&s->mutex, NULL);
+
+	s->wake_fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+	s->audio_wake_fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+	if (s->wake_fd < 0 || s->audio_wake_fd < 0) {
+		blog_s(s, LOG_ERROR, "eventfd: %s", strerror(errno));
+		if (s->wake_fd >= 0) {
+			close(s->wake_fd);
+		}
+		if (s->audio_wake_fd >= 0) {
+			close(s->audio_wake_fd);
+		}
+		pthread_mutex_destroy(&s->mutex);
+		bfree(s);
+		return NULL;
+	}
+
+	effect_path = obs_module_file("hdmirx.effect");
+	obs_enter_graphics();
+	s->effect = gs_effect_create_from_file(effect_path, NULL);
+	obs_leave_graphics();
+	bfree(effect_path);
+	if (!s->effect) {
+		blog_s(s, LOG_ERROR, "Unable to load hdmirx.effect");
+	}
+
+	hdmirx_update(s, settings);
+	return s;
+}
+
+static void hdmirx_destroy(void *data)
+{
+	struct hdmirx_source *s = data;
+
+	stop_capture(s);
+	stream_teardown(s);
+
+	obs_enter_graphics();
+	gs_effect_destroy(s->effect);
+	obs_leave_graphics();
+
+	close(s->wake_fd);
+	close(s->audio_wake_fd);
+	pthread_mutex_destroy(&s->mutex);
+	dstr_free(&s->last_status);
+	dstr_free(&s->audio_status);
+	bfree(s->device);
+	bfree(s);
+}
+
+static void hdmirx_tick(void *data, float seconds)
+{
+	struct hdmirx_source *s = data;
+	UNUSED_PARAMETER(seconds);
+
+	pthread_mutex_lock(&s->mutex);
+	if (s->fd >= 0) {
+		for (uint32_t i = 0; i < s->num_buffers; i++) {
+			struct hdmirx_buffer *b = &s->buffers[i];
+			if (b->retire_age >= 0 && ++b->retire_age > RETIRE_TICKS) {
+				b->retire_age = -1;
+				queue_buffer(s->fd, i, s->layout.v4l2_planes);
+			}
+		}
+		if (s->ready >= 0) {
+			if (s->displayed >= 0) {
+				s->buffers[s->displayed].retire_age = 0;
+			}
+			s->displayed = s->ready;
+			s->ready = -1;
+		}
+	}
+	pthread_mutex_unlock(&s->mutex);
+}
+
+static bool import_buffer(struct hdmirx_source *s, struct hdmirx_buffer *b)
+{
+	static const uint64_t linear = 0; /* DRM_FORMAT_MOD_LINEAR */
+
+	for (uint32_t p = 0; p < s->layout.gpu_planes; p++) {
+		const struct gpu_plane *gp = &s->layout.plane[p];
+		int fd = b->gpu_dmabuf >= 0 ? b->gpu_dmabuf : b->dmabuf[gp->v4l2_plane];
+
+		b->tex[p] = gs_texture_create_from_dmabuf(gp->width, gp->height, gp->drm_format, gp->gs_format, 1, &fd,
+							  &gp->pitch, &gp->offset, &linear);
+		if (!b->tex[p]) {
+			char fourcc[5];
+			blog_s(s, LOG_ERROR, "Unable to import plane %u (%s %ux%u pitch %u) as a GPU texture", p,
+			       fourcc_name(gp->drm_format, fourcc), gp->width, gp->height, gp->pitch);
+			return false;
+		}
+	}
+	return true;
+}
+
+static void draw_buffer(struct hdmirx_source *s, struct hdmirx_buffer *b)
+{
+	struct vec2 size;
+
+	vec2_set(&size, (float)s->layout.width, (float)s->layout.height);
+	gs_effect_set_texture(gs_effect_get_param_by_name(s->effect, "image"), b->tex[0]);
+	gs_effect_set_texture(gs_effect_get_param_by_name(s->effect, "image1"), b->tex[1]);
+	gs_effect_set_val(gs_effect_get_param_by_name(s->effect, "color_matrix"), s->color_matrix,
+			  sizeof(s->color_matrix));
+	gs_effect_set_val(gs_effect_get_param_by_name(s->effect, "color_range_min"), s->color_range_min,
+			  sizeof(s->color_range_min));
+	gs_effect_set_val(gs_effect_get_param_by_name(s->effect, "color_range_max"), s->color_range_max,
+			  sizeof(s->color_range_max));
+	gs_effect_set_vec2(gs_effect_get_param_by_name(s->effect, "frame_size"), &size);
+	/* Linear output where 1.0 is OBS's SDR white, as GS_CS_709_EXTENDED expects. */
+	gs_effect_set_float(gs_effect_get_param_by_name(s->effect, "maximum_over_sdr_white_nits"),
+			    10000.0f / obs_get_video_sdr_white_level());
+
+	while (gs_effect_loop(s->effect, s->pq && s->decode_pq ? s->layout.technique_pq : s->layout.technique)) {
+		gs_draw_sprite(b->tex[0], 0, s->layout.width, s->layout.height);
+	}
+}
+
+static void hdmirx_render(void *data, gs_effect_t *unused)
+{
+	struct hdmirx_source *s = data;
+	UNUSED_PARAMETER(unused);
+
+	if (!s->effect) {
+		return;
+	}
+
+	pthread_mutex_lock(&s->mutex);
+	if (s->displayed >= 0 && !s->import_failed) {
+		struct hdmirx_buffer *b = &s->buffers[s->displayed];
+		if (b->tex[0] || import_buffer(s, b)) {
+			draw_buffer(s, b);
+		} else {
+			s->import_failed = true;
+		}
+	}
+	pthread_mutex_unlock(&s->mutex);
+}
+
+/* OBS converts the source from this space to whatever it renders into: it
+ * tone-maps HDR for SDR canvases, and the HDR Tone Mapping filter only acts on
+ * sources that report an HDR space. */
+static enum gs_color_space hdmirx_get_color_space(void *data, size_t count, const enum gs_color_space *preferred_spaces)
+{
+	struct hdmirx_source *s = data;
+	UNUSED_PARAMETER(count);
+	UNUSED_PARAMETER(preferred_spaces);
+
+	pthread_mutex_lock(&s->mutex);
+	bool pq = s->fd >= 0 && s->pq && s->decode_pq;
+	pthread_mutex_unlock(&s->mutex);
+	return pq ? GS_CS_709_EXTENDED : GS_CS_SRGB;
+}
+
+static uint32_t hdmirx_get_width(void *data)
+{
+	struct hdmirx_source *s = data;
+	pthread_mutex_lock(&s->mutex);
+	uint32_t width = s->displayed >= 0 ? s->layout.width : 0;
+	pthread_mutex_unlock(&s->mutex);
+	return width;
+}
+
+static uint32_t hdmirx_get_height(void *data)
+{
+	struct hdmirx_source *s = data;
+	pthread_mutex_lock(&s->mutex);
+	uint32_t height = s->displayed >= 0 ? s->layout.height : 0;
+	pthread_mutex_unlock(&s->mutex);
+	return height;
+}
+
+static void add_info(obs_properties_t *props, const char *name, const char *label, const char *value,
+		     enum obs_text_info_type type)
+{
+	struct dstr text = {0};
+	obs_property_t *p;
+
+	dstr_printf(&text, "%s: %s", label, value);
+	p = obs_properties_add_text(props, name, text.array, OBS_TEXT_INFO);
+	obs_property_text_set_info_type(p, type);
+	dstr_free(&text);
+}
+
+static void add_signal_info(struct hdmirx_source *s, obs_properties_t *props)
+{
+	struct dstr value = {0};
+	char fourcc[5];
+
+	pthread_mutex_lock(&s->mutex);
+	add_info(props, "edid_current", obs_module_text("ReceiverEdid"), edid_name(s->edid_current),
+		 OBS_TEXT_INFO_NORMAL);
+	if (s->audio_thread_running) {
+		const char *status = s->audio_status.array ? s->audio_status.array : obs_module_text("Starting");
+		add_info(props, "audio_status", obs_module_text("Audio"), status,
+			 s->audio_status_level == LOG_WARNING ? OBS_TEXT_INFO_WARNING : OBS_TEXT_INFO_NORMAL);
+	}
+	if (s->fd < 0) {
+		const char *status = s->disconnected        ? obs_module_text("Disconnected")
+				     : s->last_status.array ? s->last_status.array
+							    : obs_module_text("Starting");
+		add_info(props, "status", obs_module_text("Status"), status,
+			 !s->disconnected && s->last_status_level == LOG_WARNING ? OBS_TEXT_INFO_WARNING
+										 : OBS_TEXT_INFO_NORMAL);
+		pthread_mutex_unlock(&s->mutex);
+		return;
+	}
+
+	const struct v4l2_bt_timings *bt = &s->timings;
+	const char *desc = fourcc_description(s->layout.fourcc);
+	bool rgb = s->layout.fourcc == V4L2_PIX_FMT_BGR24;
+
+	add_info(props, "status", obs_module_text("Status"), obs_module_text("Capturing"), OBS_TEXT_INFO_NORMAL);
+
+	dstr_printf(&value, "%ux%u%s", s->layout.width, s->layout.height, bt->interlaced ? "i" : "p");
+	add_info(props, "resolution", obs_module_text("Resolution"), value.array, OBS_TEXT_INFO_NORMAL);
+
+	/* Prefer the measured frame rate when the receiver's timings disagree. */
+	double fps = timings_fps(bt);
+	double measured = s->frame_interval > 0.0 ? 1.0 / s->frame_interval : 0.0;
+	bool mismatch = measured > 0.0 && fabs(measured - fps) > fps * 0.05;
+	if (mismatch) {
+		uint64_t total = (uint64_t)V4L2_DV_BT_FRAME_WIDTH(bt) * V4L2_DV_BT_FRAME_HEIGHT(bt);
+		dstr_printf(&value, "%.2f Hz (%s %.2f Hz)", measured, obs_module_text("ReceiverReports"), fps);
+		add_info(props, "fps", obs_module_text("FrameRate"), value.array, OBS_TEXT_INFO_NORMAL);
+		dstr_printf(&value, "%.2f MHz (%s %.2f MHz)", measured * (double)total / 1e6,
+			    obs_module_text("ReceiverReports"), (double)bt->pixelclock / 1e6);
+	} else {
+		dstr_printf(&value, "%.2f Hz", fps);
+		add_info(props, "fps", obs_module_text("FrameRate"), value.array, OBS_TEXT_INFO_NORMAL);
+		dstr_printf(&value, "%.2f MHz", (double)bt->pixelclock / 1e6);
+	}
+	add_info(props, "pixelclock", obs_module_text("PixelClock"), value.array, OBS_TEXT_INFO_NORMAL);
+
+	dstr_copy(&value, fourcc_name(s->layout.fourcc, fourcc));
+	if (desc) {
+		dstr_catf(&value, " (%s)", desc);
+	}
+	/* The receiver has no 10-bit store for 4:4:4 and RGB. */
+	enum obs_text_info_type format_type = OBS_TEXT_INFO_NORMAL;
+	if (s->pq && (rgb || s->layout.fourcc == V4L2_PIX_FMT_NV24)) {
+		dstr_catf(&value, ", %s", obs_module_text("HdrStored8Bit"));
+		format_type = OBS_TEXT_INFO_WARNING;
+	}
+	add_info(props, "format", obs_module_text("PixelFormat"), value.array, format_type);
+
+	const char *matrix = s->colorspace == VIDEO_CS_601       ? "Rec. 601"
+			     : s->colorspace == VIDEO_CS_2100_PQ ? "Rec. 2020"
+								 : "Rec. 709";
+	dstr_printf(&value, "%s, %s", rgb ? (s->pq ? "RGB, Rec. 2020" : "RGB") : matrix,
+		    obs_module_text(s->range == VIDEO_RANGE_FULL ? "FullRange" : "LimitedRange"));
+	add_info(props, "color", obs_module_text("Color"), value.array, OBS_TEXT_INFO_NORMAL);
+
+	if (s->pq) {
+		dstr_printf(&value, "%s, HDR10 (PQ)", obs_module_text("Yes"));
+		if (s->max_cll) {
+			dstr_catf(&value, ", MaxCLL %u nits", s->max_cll);
+		}
+		if (!s->decode_pq) {
+			dstr_catf(&value, ", %s", obs_module_text("HdrPassedThrough"));
+		}
+	} else {
+		dstr_printf(&value, "%s (SDR)", obs_module_text("No"));
+		if (s->edid_current != EDID_HDR && s->edid_current != EDID_HIGH_REFRESH_HDR &&
+		    s->edid_current != EDID_CUSTOM) {
+			dstr_catf(&value, ", %s", obs_module_text("EdidNoHdr"));
+		}
+	}
+	add_info(props, "hdr", obs_module_text("Hdr"), value.array, OBS_TEXT_INFO_NORMAL);
+
+	/* Frames never pass through the CPU. 8-bit frames go straight to the GPU,
+	 * which converts them in hdmirx.effect; 10-bit frames pass through RGA3. */
+	bool decode = s->pq && s->decode_pq;
+	const char *shader = rgb ? (decode ? "BGR → RGB, PQ → linear Rec. 709" : "BGR → RGB")
+				 : (decode ? "YCbCr → RGB, PQ → linear Rec. 709" : "YCbCr → RGB");
+	if (s->layout.gpu_fourcc) {
+		char gpu_fourcc[5];
+		dstr_printf(&value, "%s → %s on RGA3 (%.1f ms/frame), %s GPU shader, no CPU copy", fourcc,
+			    fourcc_name(s->layout.gpu_fourcc, gpu_fourcc), s->rga_ms, shader);
+	} else {
+		dstr_printf(&value, "%s, GPU shader, zero-copy (no CPU copy, no RGA)", shader);
+	}
+	add_info(props, "conversion", obs_module_text("Conversion"), value.array, OBS_TEXT_INFO_NORMAL);
+
+	dstr_free(&value);
+	for (uint32_t p = 0; p < s->layout.gpu_planes; p++) {
+		const struct gpu_plane *gp = &s->layout.plane[p];
+		dstr_catf(&value, "%s%s %ux%u", p ? " + " : "", gp->drm_format == DRM_FORMAT_R8 ? "R8" : "GR88",
+			  gp->width, gp->height);
+	}
+	enum obs_text_info_type import_type = OBS_TEXT_INFO_NORMAL;
+	if (s->import_failed) {
+		dstr_catf(&value, ", %s", obs_module_text("ImportFailed"));
+		import_type = OBS_TEXT_INFO_ERROR;
+	} else if (s->displayed >= 0 && s->buffers[s->displayed].tex[0]) {
+		dstr_cat(&value, ", dma-buf (linear)");
+	} else {
+		dstr_catf(&value, ", %s", obs_module_text("WaitingForFrame"));
+	}
+	add_info(props, "textures", obs_module_text("GpuTextures"), value.array, import_type);
+
+	dstr_printf(&value, "%" PRIu64 " %s, %" PRIu64 " %s", s->frames_captured, obs_module_text("Captured"),
+		    s->frames_dropped, obs_module_text("Dropped"));
+	add_info(props, "frames", obs_module_text("Frames"), value.array, OBS_TEXT_INFO_NORMAL);
+	pthread_mutex_unlock(&s->mutex);
+
+	dstr_free(&value);
+}
+
+static void reload_properties_task(void *param)
+{
+	obs_weak_source_t *weak = param;
+	obs_source_t *source = obs_weak_source_get_source(weak);
+
+	if (source) {
+		obs_source_update_properties(source);
+		obs_source_release(source);
+	}
+	obs_weak_source_release(weak);
+}
+
+/* A button returning true only redraws the properties it already has, so
+ * request fresh ones instead. Doing that from inside the click would free the
+ * clicked property, and UI tasks queued from the UI thread run immediately, so
+ * signal from the graphics thread; the window then reloads asynchronously. */
+static void reload_properties(struct hdmirx_source *s)
+{
+	obs_queue_task(OBS_TASK_GRAPHICS, reload_properties_task, obs_source_get_weak_source(s->source), false);
+}
+
+static bool refresh_clicked(obs_properties_t *props, obs_property_t *p, void *data)
+{
+	UNUSED_PARAMETER(props);
+	UNUSED_PARAMETER(p);
+	reload_properties(data);
+	return false;
+}
+
+/* Stopping the capture thread closes the device, so other programs can use the
+ * receiver until it's connected again. */
+static bool connect_clicked(obs_properties_t *props, obs_property_t *p, void *data)
+{
+	struct hdmirx_source *s = data;
+	UNUSED_PARAMETER(props);
+	UNUSED_PARAMETER(p);
+
+	s->disconnected = !s->disconnected;
+	if (s->disconnected) {
+		stop_capture(s);
+		blog_s(s, LOG_INFO, "Disconnected");
+	} else {
+		blog_s(s, LOG_INFO, "Connecting");
+		start_capture(s);
+	}
+	reload_properties(s);
+	return false;
+}
+
+static obs_properties_t *hdmirx_properties(void *data)
+{
+	struct hdmirx_source *s = data;
+	obs_properties_t *props = obs_properties_create();
+	obs_property_t *list = obs_properties_add_list(props, "device", obs_module_text("Device"), OBS_COMBO_TYPE_LIST,
+						       OBS_COMBO_FORMAT_STRING);
+
+	for_each_hdmirx(list_device_cb, list);
+	if (obs_property_list_item_count(list) == 0) {
+		obs_property_list_add_string(list, obs_module_text("NoDevice"), "");
+	}
+
+	list = obs_properties_add_list(props, "edid", obs_module_text("Edid"), OBS_COMBO_TYPE_LIST,
+				       OBS_COMBO_FORMAT_INT);
+	obs_property_list_add_int(list, obs_module_text("Edid.Unchanged"), EDID_UNCHANGED);
+	obs_property_list_add_int(list, edid_name(EDID_340M), EDID_340M);
+	obs_property_list_add_int(list, edid_name(EDID_600M), EDID_600M);
+	obs_property_list_add_int(list, edid_name(EDID_HDR), EDID_HDR);
+	obs_property_list_add_int(list, edid_name(EDID_HIGH_REFRESH), EDID_HIGH_REFRESH);
+	obs_property_list_add_int(list, edid_name(EDID_HIGH_REFRESH_HDR), EDID_HIGH_REFRESH_HDR);
+	obs_property_set_long_description(list, obs_module_text("Edid.Description"));
+
+	obs_property_t *decode = obs_properties_add_bool(props, "decode_hdr", obs_module_text("DecodeHdr"));
+	obs_property_set_long_description(decode, obs_module_text("DecodeHdr.Description"));
+
+	obs_property_t *audio = obs_properties_add_bool(props, "audio", obs_module_text("CaptureAudio"));
+	obs_property_set_long_description(audio, obs_module_text("CaptureAudio.Description"));
+
+	if (s) {
+		add_signal_info(s, props);
+		const char *connect = obs_module_text(s->disconnected ? "Connect" : "Disconnect");
+		obs_properties_add_button2(props, "connect", connect, connect_clicked, s);
+		obs_properties_add_button2(props, "refresh", obs_module_text("Refresh"), refresh_clicked, s);
+	}
+	return props;
+}
+
+static struct obs_source_info hdmirx_source_info = {
+	.id = "rockchip_hdmirx_source",
+	.type = OBS_SOURCE_TYPE_INPUT,
+	.output_flags = OBS_SOURCE_VIDEO | OBS_SOURCE_AUDIO | OBS_SOURCE_CUSTOM_DRAW | OBS_SOURCE_DO_NOT_DUPLICATE,
+	.get_name = hdmirx_get_name,
+	.create = hdmirx_create,
+	.destroy = hdmirx_destroy,
+	.update = hdmirx_update,
+	.get_defaults = hdmirx_defaults,
+	.get_properties = hdmirx_properties,
+	.video_tick = hdmirx_tick,
+	.video_render = hdmirx_render,
+	.video_get_color_space = hdmirx_get_color_space,
+	.get_width = hdmirx_get_width,
+	.get_height = hdmirx_get_height,
+	.icon_type = OBS_ICON_TYPE_CAMERA,
+};
+
+bool obs_module_load(void)
+{
+	obs_register_source(&hdmirx_source_info);
+	return true;
+}
