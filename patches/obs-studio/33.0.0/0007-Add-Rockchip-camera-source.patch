diff --git a/plugins/rockchip-camera/CMakeLists.txt b/plugins/rockchip-camera/CMakeLists.txt
new file mode 100644
index 0000000..0baf3e1
--- /dev/null
+++ b/plugins/rockchip-camera/CMakeLists.txt
@@ -0,0 +1,50 @@
+cmake_minimum_required(VERSION 3.28...3.30)
+
+option(ENABLE_ROCKCHIP_CAMERA "Build OBS with Rockchip camera (ISP) support" ON)
+
+if(NOT ENABLE_ROCKCHIP_CAMERA)
+  return()
+endif()
+
+# Rockchip's 3A engine runs the ISP for raw sensors; it is built for one ISP
+# generation (here the RK3588's ISP3x), so its headers need the matching define.
+find_path(RKAIQ_INCLUDE_DIR rk_aiq_user_api2_sysctl.h PATH_SUFFIXES rkaiq/uAPI2)
+find_library(RKAIQ_LIBRARY rkaiq)
+if(NOT RKAIQ_INCLUDE_DIR OR NOT RKAIQ_LIBRARY)
+  message(WARNING "rkaiq not found, Rockchip camera source disabled")
+  return()
+endif()
+
+add_library(rockchip-camera MODULE)
+add_library(OBS::rockchip-camera ALIAS rockchip-camera)
+
+target_sources(rockchip-camera PRIVATE rockchip-camera.c)
+
+cmake_path(GET RKAIQ_INCLUDE_DIR PARENT_PATH rkaiq_include)
+cmake_path(GET RKAIQ_LIBRARY PARENT_PATH rkaiq_libdir)
+cmake_path(GET rkaiq_libdir PARENT_PATH rkaiq_prefix)
+
+target_include_directories(
+  rockchip-camera
+  PRIVATE
+    ${rkaiq_include}
+    ${rkaiq_include}/uAPI2
+    ${rkaiq_include}/common
+    ${rkaiq_include}/xcore
+    ${rkaiq_include}/algos
+    ${rkaiq_include}/iq_parser
+    ${rkaiq_include}/iq_parser_v2
+)
+target_compile_definitions(
+  rockchip-camera
+  PRIVATE ISP_HW_V30 RKAIQ_IQ_DIR="${rkaiq_prefix}/share/rkaiq/iqfiles"
+)
+# The rkaiq headers trip over OBS's stricter warnings.
+target_compile_options(rockchip-camera PRIVATE -Wno-error -Wno-unused-parameter -Wno-sign-compare)
+
+target_link_libraries(rockchip-camera PRIVATE OBS::libobs ${RKAIQ_LIBRARY} m)
+# rkaiq declares more API than each ISP build implements. A missing symbol must
+# fail here: OBS refuses to start when a core module can't be loaded.
+target_link_options(rockchip-camera PRIVATE -Wl,-z,defs)
+
+set_target_properties_obs(rockchip-camera PROPERTIES FOLDER plugins PREFIX "")
diff --git a/plugins/rockchip-camera/data/camera.effect b/plugins/rockchip-camera/data/camera.effect
new file mode 100644
index 0000000..809c1f3
--- /dev/null
+++ b/plugins/rockchip-camera/data/camera.effect
@@ -0,0 +1,46 @@
+// Draws NV12 frames from the Rockchip ISP, imported as dma-buf textures:
+// image = Y (R8), image1 = CbCr (R8G8, R = Cb).
+
+uniform float4x4 ViewProj;
+uniform texture2d image;
+uniform texture2d image1;
+
+uniform float4x4 color_matrix;
+uniform float3 color_range_min = {0.0, 0.0, 0.0};
+uniform float3 color_range_max = {1.0, 1.0, 1.0};
+
+sampler_state def_sampler {
+	Filter   = Linear;
+	AddressU = Clamp;
+	AddressV = Clamp;
+};
+
+struct VertInOut {
+	float4 pos : POSITION;
+	float2 uv  : TEXCOORD0;
+};
+
+VertInOut VSDefault(VertInOut vert_in)
+{
+	VertInOut vert_out;
+	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
+	vert_out.uv  = vert_in.uv;
+	return vert_out;
+}
+
+float4 PSYCbCr(VertInOut vert_in) : TARGET
+{
+	float y = image.Sample(def_sampler, vert_in.uv).r;
+	float2 cbcr = image1.Sample(def_sampler, vert_in.uv).rg;
+	float3 yuv = clamp(float3(y, cbcr), color_range_min, color_range_max);
+	return float4(saturate(mul(float4(yuv, 1.0), color_matrix).rgb), 1.0);
+}
+
+technique YCbCr
+{
+	pass
+	{
+		vertex_shader = VSDefault(vert_in);
+		pixel_shader  = PSYCbCr(vert_in);
+	}
+}
