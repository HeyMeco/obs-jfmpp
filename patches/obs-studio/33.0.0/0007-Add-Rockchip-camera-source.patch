+
+static const char *camera_get_name(void *unused)
+{
+	UNUSED_PARAMETER(unused);
+	return obs_module_text("RockchipCamera");
+}
+
+static void read_settings(obs_data_t *settings, struct image_settings *st)
+{
+	st->antiflicker = (int)obs_data_get_int(settings, "antiflicker");
+	st->fps = (int)obs_data_get_int(settings, "fps");
+	st->exposure_auto = obs_data_get_bool(settings, "exposure_auto");
+	st->shutter = (int)obs_data_get_int(settings, "shutter");
+	if (st->shutter <= 0) {
+		st->shutter = SHUTTER_DEFAULT;
+	}
+	st->gain = obs_data_get_double(settings, "gain");
+	st->wb_auto = obs_data_get_bool(settings, "wb_auto");
+	st->wb_ct = (int)obs_data_get_int(settings, "wb_ct");
+	st->brightness = (int)obs_data_get_int(settings, "brightness");
+	st->contrast = (int)obs_data_get_int(settings, "contrast");
+	st->saturation = (int)obs_data_get_int(settings, "saturation");
+	st->hue = (int)obs_data_get_int(settings, "hue");
+	st->sharpness = (int)obs_data_get_int(settings, "sharpness");
+	st->mirror = obs_data_get_bool(settings, "mirror");
+	st->flip = obs_data_get_bool(settings, "flip");
+}
+
+static void camera_update(void *data, obs_data_t *settings)
+{
+	struct camera_source *s = data;
+	const char *sensor = obs_data_get_string(settings, "sensor");
+	const char *resolution = obs_data_get_string(settings, "resolution");
+	uint32_t w = 0, h = 0;
+	struct image_settings st, old;
+
+	if (sscanf(resolution, "%ux%u", &w, &h) != 2) {
+		w = h = 0;
+	}
+	read_settings(settings, &st);
+
+	if (s->thread_running && s->sensor && strcmp(s->sensor, sensor) == 0 && s->req_width == w &&
+	    s->req_height == h) {
+		/* Image settings apply to the running camera. */
+		pthread_mutex_lock(&aiq_lock);
+		pthread_mutex_lock(&s->mutex);
+		old = s->settings;
+		s->settings = st;
+		pthread_mutex_unlock(&s->mutex);
+		apply_settings(s, &st, &old);
+		pthread_mutex_unlock(&aiq_lock);
+		return;
+	}
+
+	stop_capture(s);
+	pthread_mutex_lock(&s->mutex);
+	s->settings = st;
+	pthread_mutex_unlock(&s->mutex);
+	bfree(s->sensor);
+	s->sensor = bstrdup(sensor);
+	s->req_width = w;
+	s->req_height = h;
+	if (!s->disconnected) {
+		start_capture(s);
+	}
+}
+
+static void camera_defaults(obs_data_t *settings)
+{
+	obs_data_set_default_string(settings, "resolution", "");
+	obs_data_set_default_int(settings, "antiflicker", 50);
+	obs_data_set_default_int(settings, "fps", 0);
+	obs_data_set_default_bool(settings, "exposure_auto", true);
+	obs_data_set_default_int(settings, "shutter", SHUTTER_DEFAULT);
+	obs_data_set_default_double(settings, "gain", 1.0);
+	obs_data_set_default_bool(settings, "wb_auto", true);
+	obs_data_set_default_int(settings, "wb_ct", WB_CT_DEFAULT);
+	obs_data_set_default_int(settings, "brightness", LEVEL_DEFAULT);
+	obs_data_set_default_int(settings, "contrast", LEVEL_DEFAULT);
+	obs_data_set_default_int(settings, "saturation", LEVEL_DEFAULT);
+	obs_data_set_default_int(settings, "hue", LEVEL_DEFAULT);
+	obs_data_set_default_int(settings, "sharpness", SHARPNESS_DEFAULT);
+	obs_data_set_default_bool(settings, "mirror", false);
+	obs_data_set_default_bool(settings, "flip", false);
+}
+
+static void *camera_create(obs_data_t *settings, obs_source_t *source)
+{
+	struct camera_source *s = bzalloc(sizeof(*s));
+	char *effect_path;
+
+	s->source = source;
+	s->fd = -1;
+	s->displayed = -1;
+	pthread_mutex_init(&s->mutex, NULL);
+
+	s->wake_fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+	if (s->wake_fd < 0) {
+		blog_s(s, LOG_ERROR, "eventfd: %s", strerror(errno));
+		pthread_mutex_destroy(&s->mutex);
+		bfree(s);
+		return NULL;
+	}
+
+	effect_path = obs_module_file("camera.effect");
+	obs_enter_graphics();
+	s->effect = gs_effect_create_from_file(effect_path, NULL);
+	obs_leave_graphics();
+	bfree(effect_path);
+	if (!s->effect) {
+		blog_s(s, LOG_ERROR, "Unable to load camera.effect");
+	}
+
+	camera_update(s, settings);
+	return s;
+}
+
+static void camera_destroy(void *data)
+{
+	struct camera_source *s = data;
+
+	stop_capture(s);
+
+	obs_enter_graphics();
+	gs_effect_destroy(s->effect);
+	obs_leave_graphics();
+
+	close(s->wake_fd);
+	pthread_mutex_destroy(&s->mutex);
+	dstr_free(&s->last_status);
+	dstr_free(&s->iq_file);
+	dstr_free(&s->module);
+	bfree(s->sensor);
+	bfree(s->device);
+	bfree(s);
+}
+
+static void camera_tick(void *data, float seconds)
+{
+	struct camera_source *s = data;
+	uint64_t obs_frame_ns = video_output_get_frame_time(obs_get_video());
+
+	/* When OBS falls behind, it skips the frames it missed; skip as many
+	 * captured frames so the latency doesn't grow. */
+	uint32_t advance = obs_frame_ns ? (uint32_t)lround(seconds * 1e9 / (double)obs_frame_ns) : 1;
+	if (advance < 1) {
+		advance = 1;
+	}
+
+	pthread_mutex_lock(&s->mutex);
+	s->last_tick_ns = os_gettime_ns();
+	if (s->fd >= 0) {
+		for (uint32_t i = 0; i < s->num_buffers; i++) {
+			struct camera_buffer *b = &s->buffers[i];
+			if (b->retire_age >= 0 && ++b->retire_age > RETIRE_TICKS) {
+				b->retire_age = -1;
+				queue_buffer(s->fd, i);
+			}
+		}
+		for (; advance > 1 && s->queued > 1; advance--) {
+			queue_buffer(s->fd, s->queue[0]);
+			memmove(s->queue, s->queue + 1, --s->queued * sizeof(s->queue[0]));
+		}
+		if (s->queued > 0) {
+			if (s->displayed >= 0) {
+				s->buffers[s->displayed].retire_age = 0;
+			}
+			s->displayed = s->queue[0];
+			memmove(s->queue, s->queue + 1, --s->queued * sizeof(s->queue[0]));
+		}
+	}
+	pthread_mutex_unlock(&s->mutex);
+}
+
+static bool import_buffer(struct camera_source *s, struct camera_buffer *b)
+{
+	static const uint64_t linear = 0; /* DRM_FORMAT_MOD_LINEAR */
+	uint32_t pitch = s->pitch;
+	uint32_t offsets[2] = {0, s->pitch * s->height};
+
+	b->tex[0] = gs_texture_create_from_dmabuf(s->width, s->height, DRM_FORMAT_R8, GS_R8, 1, &b->dmabuf, &pitch,
+						  &offsets[0], &linear);
+	b->tex[1] = gs_texture_create_from_dmabuf(s->width / 2, s->height / 2, DRM_FORMAT_GR88, GS_R8G8, 1,
+						  &b->dmabuf, &pitch, &offsets[1], &linear);
+	if (!b->tex[0] || !b->tex[1]) {
+		blog_s(s, LOG_ERROR, "Unable to import an NV12 buffer (%ux%u pitch %u) as GPU textures", s->width,
+		       s->height, s->pitch);
+		return false;
+	}
+	return true;
+}
+
+static void camera_render(void *data, gs_effect_t *unused)
+{
+	struct camera_source *s = data;
+	UNUSED_PARAMETER(unused);
+
+	if (!s->effect) {
+		return;
+	}
+
+	pthread_mutex_lock(&s->mutex);
+	if (s->displayed >= 0 && !s->import_failed) {
+		struct camera_buffer *b = &s->buffers[s->displayed];
+		if (b->tex[0] || import_buffer(s, b)) {
+			gs_effect_set_texture(gs_effect_get_param_by_name(s->effect, "image"), b->tex[0]);
+			gs_effect_set_texture(gs_effect_get_param_by_name(s->effect, "image1"), b->tex[1]);
+			gs_effect_set_val(gs_effect_get_param_by_name(s->effect, "color_matrix"), s->color_matrix,
+					  sizeof(s->color_matrix));
+			gs_effect_set_val(gs_effect_get_param_by_name(s->effect, "color_range_min"),
+					  s->color_range_min, sizeof(s->color_range_min));
+			gs_effect_set_val(gs_effect_get_param_by_name(s->effect, "color_range_max"),
+					  s->color_range_max, sizeof(s->color_range_max));
+			while (gs_effect_loop(s->effect, "YCbCr")) {
+				gs_draw_sprite(b->tex[0], 0, s->width, s->height);
+			}
+		} else {
+			s->import_failed = true;
+		}
+	}
+	pthread_mutex_unlock(&s->mutex);
+}
+
+static uint32_t camera_get_width(void *data)
+{
+	struct camera_source *s = data;
+	pthread_mutex_lock(&s->mutex);
+	uint32_t width = s->displayed >= 0 ? s->width : 0;
+	pthread_mutex_unlock(&s->mutex);
+	return width;
+}
+
+static uint32_t camera_get_height(void *data)
+{
+	struct camera_source *s = data;
+	pthread_mutex_lock(&s->mutex);
+	uint32_t height = s->displayed >= 0 ? s->height : 0;
+	pthread_mutex_unlock(&s->mutex);
+	return height;
+}
+
+static void add_info(obs_properties_t *props, const char *name, const char *label, const char *value,
+		     enum obs_text_info_type type)
+{
+	struct dstr text = {0};
+	obs_property_t *p;
+
+	dstr_printf(&text, "%s: %s", label, value);
+	p = obs_properties_add_text(props, name, text.array, OBS_TEXT_INFO);
+	obs_property_text_set_info_type(p, type);
+	dstr_free(&text);
+}
+
+static void add_exposure_info(struct camera_source *s, obs_properties_t *props)
+{
+	Uapi_ExpQueryInfo_t exp;
+	unsigned int ct = 0;
+	bool have_exp = false, have_ct = false;
+	struct dstr value = {0};
+
+	memset(&exp, 0, sizeof(exp));
+	pthread_mutex_lock(&aiq_lock);
+	if (s->aiq) {
+		have_exp = rk_aiq_user_api2_ae_queryExpResInfo(s->aiq, &exp) == XCAM_RETURN_NO_ERROR;
+		have_ct = rk_aiq_uapi2_getWBCT(s->aiq, &ct) == XCAM_RETURN_NO_ERROR && ct > 0;
+	}
+	pthread_mutex_unlock(&aiq_lock);
+
+	if (have_exp) {
+		const RkAiqExpRealParam_t *e = &exp.LinAeInfo.LinearExp;
+		double t = e->integration_time;
+		if (t > 0.0 && t < 0.5) {
+			dstr_printf(&value, "1/%.0f s (%.2f ms), %s %.2fx", 1.0 / t, t * 1000.0, obs_module_text("Gain"),
+				    e->analog_gain * (e->digital_gain > 0.0f ? e->digital_gain : 1.0f) *
+					    (e->isp_dgain > 0.0f ? e->isp_dgain : 1.0f));
+		} else {
+			dstr_printf(&value, "%.3f s, %s %.2fx", t, obs_module_text("Gain"), e->analog_gain);
+		}
+		if (exp.IsExpMax) {
+			dstr_catf(&value, ", %s", obs_module_text("ExposureMax"));
+		}
+		add_info(props, "exposure_now", obs_module_text("Exposure"), value.array,
+			 exp.IsExpMax ? OBS_TEXT_INFO_WARNING : OBS_TEXT_INFO_NORMAL);
+	}
+	if (have_ct) {
+		dstr_printf(&value, "%u K", ct);
+		add_info(props, "wb_now", obs_module_text("WhiteBalance"), value.array, OBS_TEXT_INFO_NORMAL);
+	}
+	dstr_free(&value);
+}
+
+static void add_camera_info(struct camera_source *s, obs_properties_t *props)
+{
+	struct dstr value = {0};
+
+	pthread_mutex_lock(&s->mutex);
+	if (s->fd < 0) {
+		const char *status = s->disconnected        ? obs_module_text("Disconnected")
+				     : s->last_status.array ? s->last_status.array
+							    : obs_module_text("Starting");
+		add_info(props, "status", obs_module_text("Status"), status,
+			 !s->disconnected && s->last_status_level == LOG_WARNING ? OBS_TEXT_INFO_WARNING
+										 : OBS_TEXT_INFO_NORMAL);
+		pthread_mutex_unlock(&s->mutex);
+		return;
+	}
+
+	add_info(props, "status", obs_module_text("Status"), obs_module_text("Capturing"), OBS_TEXT_INFO_NORMAL);
+	if (s->module.len) {
+		add_info(props, "module", obs_module_text("Module"), s->module.array, OBS_TEXT_INFO_NORMAL);
+	}
+
+	dstr_printf(&value, "%ux%u (%s %ux%u @ %u fps)", s->width, s->height, obs_module_text("Sensor"),
+		    s->sensor_width, s->sensor_height, s->sensor_fps);
+	add_info(props, "resolution_now", obs_module_text("Resolution"), value.array, OBS_TEXT_INFO_NORMAL);
+
+	if (s->frame_interval > 0.0) {
+		dstr_printf(&value, "%.2f fps", 1.0 / s->frame_interval);
+		add_info(props, "fps_now", obs_module_text("FrameRate"), value.array, OBS_TEXT_INFO_NORMAL);
+	}
+
+	if (s->external_3a) {
+		add_info(props, "tuning", obs_module_text("Tuning"), obs_module_text("Tuning.External"),
+			 OBS_TEXT_INFO_WARNING);
+	} else {
+		dstr_copy_dstr(&value, &s->iq_file);
+		if (s->iq_fallback) {
+			dstr_catf(&value, " (%s)", obs_module_text("Tuning.Fallback"));
+		}
+		add_info(props, "tuning", obs_module_text("Tuning"), value.array,
+			 s->iq_fallback ? OBS_TEXT_INFO_WARNING : OBS_TEXT_INFO_NORMAL);
+	}
+
+	dstr_printf(&value, "NV12 (%s, %s), %s", s->colorspace == VIDEO_CS_709 ? "Rec. 709" : "Rec. 601",
+		    obs_module_text(s->range == VIDEO_RANGE_FULL ? "FullRange" : "LimitedRange"),
+		    obs_module_text("Conversion.Path"));
+	enum obs_text_info_type conv_type = OBS_TEXT_INFO_NORMAL;
+	if (s->import_failed) {
+		dstr_catf(&value, ", %s", obs_module_text("ImportFailed"));
+		conv_type = OBS_TEXT_INFO_ERROR;
+	}
+	add_info(props, "conversion", obs_module_text("Conversion"), value.array, conv_type);
+
+	format_duration(&value, s->capture_start_ns ? os_gettime_ns() - s->capture_start_ns : 0);
+	add_info(props, "capturing_for", obs_module_text("CapturingFor"), value.array, OBS_TEXT_INFO_NORMAL);
+
+	uint64_t recent = recent_drops(s);
+	uint64_t total = s->frames_captured + s->frames_dropped;
+	dstr_printf(&value, "%" PRIu64 " %s, %" PRIu64 " (%.3f%%) %s", recent, obs_module_text("LastMinute"),
+		    s->frames_dropped, total ? 100.0 * (double)s->frames_dropped / (double)total : 0.0,
+		    obs_module_text("Total"));
+	add_info(props, "dropped", obs_module_text("DroppedFrames"), value.array,
+		 recent ? OBS_TEXT_INFO_WARNING : OBS_TEXT_INFO_NORMAL);
+	if (s->frames_skipped) {
+		dstr_printf(&value, "%" PRIu64 " %s", s->frames_skipped, obs_module_text("SkippedFrames.Reason"));
+		add_info(props, "skipped", obs_module_text("SkippedFrames"), value.array, OBS_TEXT_INFO_NORMAL);
+	}
+	pthread_mutex_unlock(&s->mutex);
+	dstr_free(&value);
+
+	add_exposure_info(s, props);
+}
+
+static void reload_properties_task(void *param)
+{
+	obs_weak_source_t *weak = param;
+	obs_source_t *source = obs_weak_source_get_source(weak);
+
+	if (source) {
+		obs_source_update_properties(source);
+		obs_source_release(source);
+	}
+	obs_weak_source_release(weak);
+}
+
+/* As in the HDMI input source: reload asynchronously from the graphics thread. */
+static void reload_properties(struct camera_source *s)
+{
+	obs_queue_task(OBS_TASK_GRAPHICS, reload_properties_task, obs_source_get_weak_source(s->source), false);
+}
+
+static bool refresh_clicked(obs_properties_t *props, obs_property_t *p, void *data)
+{
+	UNUSED_PARAMETER(props);
+	UNUSED_PARAMETER(p);
+	reload_properties(data);
+	return false;
+}
+
+static bool connect_clicked(obs_properties_t *props, obs_property_t *p, void *data)
+{
+	struct camera_source *s = data;
+	UNUSED_PARAMETER(props);
+	UNUSED_PARAMETER(p);
+
+	s->disconnected = !s->disconnected;
+	if (s->disconnected) {
+		stop_capture(s);
+		blog_s(s, LOG_INFO, "Disconnected");
+	} else {
+		blog_s(s, LOG_INFO, "Connecting");
+		start_capture(s);
+	}
+	reload_properties(s);
+	return false;
+}
+
+static bool exposure_auto_changed(obs_properties_t *props, obs_property_t *p, obs_data_t *settings)
+{
+	UNUSED_PARAMETER(p);
+	bool manual = !obs_data_get_bool(settings, "exposure_auto");
+	obs_property_set_visible(obs_properties_get(props, "shutter"), manual);
+	obs_property_set_visible(obs_properties_get(props, "gain"), manual);
+	return true;
+}
+
+static bool wb_auto_changed(obs_properties_t *props, obs_property_t *p, obs_data_t *settings)
+{
+	UNUSED_PARAMETER(p);
+	obs_property_set_visible(obs_properties_get(props, "wb_ct"), !obs_data_get_bool(settings, "wb_auto"));
+	return true;
+}
+
+static void add_resolution(obs_property_t *list, uint32_t w, uint32_t h, uint32_t max_w, uint32_t max_h)
+{
+	struct dstr value = {0};
+	if (w > max_w || h > max_h) {
+		return;
+	}
+	dstr_printf(&value, "%ux%u", w, h);
+	obs_property_list_add_string(list, value.array, value.array);
+	dstr_free(&value);
+}
+
+static obs_properties_t *camera_properties(void *data)
+{
+	struct camera_source *s = data;
+	obs_properties_t *props = obs_properties_create();
+	obs_property_t *p;
+
+	struct list_cameras cams = {.sensor = s && s->sensor && *s->sensor ? s->sensor : NULL};
+	struct dstr label = {0};
+
+	p = obs_properties_add_list(props, "sensor", obs_module_text("Camera"), OBS_COMBO_TYPE_LIST,
+				    OBS_COMBO_FORMAT_STRING);
+	cams.list = p;
+	for_each_camera(list_camera_cb, &cams);
+	if (obs_property_list_item_count(p) == 0) {
+		obs_property_list_add_string(p, obs_module_text("NoCamera"), "");
+	}
+
+	/* The ISP's largest output (the sensor's active area) and its frame
+	 * rate; asked from the devices, so they show before capture starts. */
+	uint32_t max_w = 0, max_h = 0, sensor_w = 0, sensor_h = 0, max_fps = 0;
+	if (cams.path) {
+		int fd = open(cams.path, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+		if (fd >= 0) {
+			isp_max_size(fd, &max_w, &max_h);
+			close(fd);
+		}
+		pthread_mutex_lock(&aiq_lock);
+		sensor_mode(cams.found_sensor, &sensor_w, &sensor_h, &max_fps);
+		pthread_mutex_unlock(&aiq_lock);
+	}
+
+	/* The ISP scales down, keeping 16:9 sensors at 16:9. */
+	p = obs_properties_add_list(props, "resolution", obs_module_text("Resolution"), OBS_COMBO_TYPE_LIST,
+				    OBS_COMBO_FORMAT_STRING);
+	if (max_w) {
+		dstr_printf(&label, "%s (%ux%u)", obs_module_text("Resolution.Full"), max_w, max_h);
+	} else {
+		dstr_copy(&label, obs_module_text("Resolution.Full"));
+		max_w = 3840;
+		max_h = 2160;
+	}
+	obs_property_list_add_string(p, label.array, "");
+	add_resolution(p, 2560, 1440, max_w, max_h);
+	add_resolution(p, 1920, 1080, max_w, max_h);
+	add_resolution(p, 1280, 720, max_w, max_h);
+
+	/* The sensor driver's mode sets the highest rate; rkaiq can only
+	 * lengthen frames from there. */
+	static const int rates[] = {120, 100, 90, 60, 50, 30, 25, 24, 20, 15};
+	p = obs_properties_add_list(props, "fps", obs_module_text("FrameRate"), OBS_COMBO_TYPE_LIST,
+				    OBS_COMBO_FORMAT_INT);
+	if (max_fps) {
+		dstr_printf(&label, "%s (%u fps)", obs_module_text("FrameRate.Sensor"), max_fps);
+	} else {
+		dstr_copy(&label, obs_module_text("FrameRate.Sensor"));
+		max_fps = 30;
+	}
+	obs_property_list_add_int(p, label.array, 0);
+	for (size_t i = 0; i < sizeof(rates) / sizeof(rates[0]); i++) {
+		if ((uint32_t)rates[i] < max_fps) {
+			dstr_printf(&label, "%d fps", rates[i]);
+			obs_property_list_add_int(p, label.array, rates[i]);
+		}
+	}
+	obs_property_list_add_int(p, obs_module_text("FrameRate.Variable"), -1);
+	dstr_free(&label);
+	bfree(cams.path);
+	bfree(cams.found_sensor);
+	obs_property_set_long_description(p, obs_module_text("FrameRate.Description"));
+
+	p = obs_properties_add_list(props, "antiflicker", obs_module_text("AntiFlicker"), OBS_COMBO_TYPE_LIST,
+				    OBS_COMBO_FORMAT_INT);
+	obs_property_list_add_int(p, obs_module_text("AntiFlicker.50"), 50);
+	obs_property_list_add_int(p, obs_module_text("AntiFlicker.60"), 60);
+	obs_property_list_add_int(p, obs_module_text("AntiFlicker.Off"), 0);
+	obs_property_set_long_description(p, obs_module_text("AntiFlicker.Description"));
+
+	p = obs_properties_add_bool(props, "exposure_auto", obs_module_text("ExposureAuto"));
+	obs_property_set_modified_callback(p, exposure_auto_changed);
+	/* Standard shutter speeds, up to one frame of the sensor's mode; 1/50
+	 * and 1/100 (1/60 and 1/120) don't flicker under 50 Hz (60 Hz) lights. */
+	static const int shutters[] = {15, 25, 30, 50, 60, 100, 120, 125, 250, 500, 1000, 2000, 4000, 8000};
+	p = obs_properties_add_list(props, "shutter", obs_module_text("ShutterSpeed"), OBS_COMBO_TYPE_LIST,
+				    OBS_COMBO_FORMAT_INT);
+	for (size_t i = 0; i < sizeof(shutters) / sizeof(shutters[0]); i++) {
+		if ((uint32_t)shutters[i] >= max_fps) {
+			struct dstr name = {0};
+			dstr_printf(&name, "1/%d s", shutters[i]);
+			obs_property_list_add_int(p, name.array, shutters[i]);
+			dstr_free(&name);
+		}
+	}
+	obs_property_set_long_description(p, obs_module_text("ShutterSpeed.Description"));
+	p = obs_properties_add_float_slider(props, "gain", obs_module_text("Gain"), 1.0, 64.0, 0.1);
+	obs_property_float_set_suffix(p, "x");
+
+	p = obs_properties_add_bool(props, "wb_auto", obs_module_text("WhiteBalanceAuto"));
+	obs_property_set_modified_callback(p, wb_auto_changed);
+	p = obs_properties_add_int_slider(props, "wb_ct", obs_module_text("ColorTemperature"), 2800, 7500, 100);
+	obs_property_int_set_suffix(p, " K");
+
+	obs_properties_add_int_slider(props, "brightness", obs_module_text("Brightness"), 0, 255, 1);
+	obs_properties_add_int_slider(props, "contrast", obs_module_text("Contrast"), 0, 255, 1);
+	obs_properties_add_int_slider(props, "saturation", obs_module_text("Saturation"), 0, 255, 1);
+	obs_properties_add_int_slider(props, "hue", obs_module_text("Hue"), 0, 255, 1);
+	obs_properties_add_int_slider(props, "sharpness", obs_module_text("Sharpness"), 0, 100, 1);
+	obs_properties_add_bool(props, "mirror", obs_module_text("Mirror"));
+	obs_properties_add_bool(props, "flip", obs_module_text("Flip"));
+
+	if (s) {
+		add_camera_info(s, props);
+		const char *connect = obs_module_text(s->disconnected ? "Connect" : "Disconnect");
+		obs_properties_add_button2(props, "connect", connect, connect_clicked, s);
+		obs_properties_add_button2(props, "refresh", obs_module_text("Refresh"), refresh_clicked, s);
+	}
+	return props;
+}
+
+static struct obs_source_info camera_source_info = {
+	.id = "rockchip_camera_source",
+	.type = OBS_SOURCE_TYPE_INPUT,
+	.output_flags = OBS_SOURCE_VIDEO | OBS_SOURCE_CUSTOM_DRAW | OBS_SOURCE_DO_NOT_DUPLICATE,
+	.get_name = camera_get_name,
+	.create = camera_create,
+	.destroy = camera_destroy,
+	.update = camera_update,
+	.get_defaults = camera_defaults,
+	.get_properties = camera_properties,
+	.video_tick = camera_tick,
+	.video_render = camera_render,
+	.get_width = camera_get_width,
+	.get_height = camera_get_height,
+	.icon_type = OBS_ICON_TYPE_CAMERA,
+};
+
+bool obs_module_load(void)
+{
+	obs_register_source(&camera_source_info);
+	return true;
+}
