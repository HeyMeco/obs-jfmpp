 static const char *run_program_init = "run_program_init";
+#ifdef __linux__
+/* Name of the Mesa Arm Mali driver we raised the GL version for, if any. */
+static const char *mesaMaliGlOverride = nullptr;
+
+/* Mesa's Panthor/Panfrost drivers (Arm Mali, e.g. Rockchip RK3588) don't advertise
+ * the OpenGL 3.3 core profile OBS requires, but run OBS fine when told to. Must run
+ * before any GL context is created; user-set values are left alone. */
+static void apply_mesa_mali_gl_override()
+{
+	glob_t drivers;
+	if (glob("/sys/class/drm/card*/device/driver", 0, nullptr, &drivers) != 0)
+		return;
+
+	for (size_t i = 0; i < drivers.gl_pathc && !mesaMaliGlOverride; i++) {
+		char target[PATH_MAX];
+		ssize_t len = readlink(drivers.gl_pathv[i], target, sizeof(target) - 1);
+		if (len <= 0)
+			continue;
+		target[len] = '\0';
+
+		const char *name = strrchr(target, '/');
+		name = name ? name + 1 : target;
+		if (strcmp(name, "panthor") == 0)
+			mesaMaliGlOverride = "panthor";
+		else if (strcmp(name, "panfrost") == 0)
+			mesaMaliGlOverride = "panfrost";
+	}
+	globfree(&drivers);
+
+	if (mesaMaliGlOverride) {
+		setenv("MESA_GL_VERSION_OVERRIDE", "3.3", 0);
+		setenv("MESA_GLSL_VERSION_OVERRIDE", "330", 0);
+	}
+}
+#endif
