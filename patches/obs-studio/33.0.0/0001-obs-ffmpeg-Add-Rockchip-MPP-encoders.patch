+    along with this program.  If not, see <http://www.gnu.org/licenses/>.
+******************************************************************************/
+
+#include "obs-ffmpeg-video-encoders.h"
+
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_drm.h>
+#include <EGL/egl.h>
+#include <drm_fourcc.h>
+
+#define do_log(level, format, ...) \
+	blog(level, "[rkmpp encoder: '%s'] " format, obs_encoder_get_name(enc->ffve.encoder), ##__VA_ARGS__)
+
+#define warn(format, ...) do_log(LOG_WARNING, format, ##__VA_ARGS__)
+#define info(format, ...) do_log(LOG_INFO, format, ##__VA_ARGS__)
+
+/* Frames the MPP frame pool can have in flight; each one is imported into the
+ * GPU once and reused. */
+#define RKMPP_MAX_SURFACES 16
+
+enum rkmpp_codec {
+	RKMPP_CODEC_H264,
+	RKMPP_CODEC_HEVC,
+};
+
+/* An MPP frame buffer imported into the GPU as the NV12 planes OBS renders. */
+struct rkmpp_surface {
+	int fd;
+	gs_texture_t *tex[2];
+};
+
+struct rkmpp_encoder {
+	struct ffmpeg_video_encoder ffve;
+	enum rkmpp_codec codec;
+
+	/* Texture encoding: OBS's NV12 output is copied on the GPU into dma-bufs
+	 * from MPP's frame pool, so no frame is read back to the CPU. */
+	bool texture;
+	AVBufferRef *hw_frames;
+	struct rkmpp_surface surfaces[RKMPP_MAX_SURFACES];
+	size_t num_surfaces;
+	bool sync_warned;
+
+	DARRAY(uint8_t) header;
+};
+
+static const char *h264_rkmpp_getname(void *unused)
+{
+	UNUSED_PARAMETER(unused);
+	return obs_module_text("RKMPP.H264");
+}
+
+static const char *hevc_rkmpp_getname(void *unused)
+{
+	UNUSED_PARAMETER(unused);
+	return obs_module_text("RKMPP.HEVC");
+}
+
+/* The software-frame path of the MPP encoders handles 8-bit 4:2:0 input. */
+static void rkmpp_video_info(void *data, struct video_scale_info *info)
+{
+	UNUSED_PARAMETER(data);
+
+	if (info->format != VIDEO_FORMAT_NV12 && info->format != VIDEO_FORMAT_I420)
+		info->format = VIDEO_FORMAT_NV12;
+}
+
+/* The encoder takes DRM PRIME frames from an MPP frame pool instead of
+ * copying system memory frames into one. */
+static bool rkmpp_init_hw_frames(struct rkmpp_encoder *enc)
+{
+	AVCodecContext *context = enc->ffve.context;
+	AVBufferRef *device = NULL;
+	int ret;
+
+	ret = av_hwdevice_ctx_create(&device, AV_HWDEVICE_TYPE_RKMPP, NULL, NULL, 0);
+	if (ret < 0) {
+		warn("Failed to create the MPP device: %s", av_err2str(ret));
+		return false;
+	}
+
+	enc->hw_frames = av_hwframe_ctx_alloc(device);
+	av_buffer_unref(&device);
+	if (!enc->hw_frames) {
+		warn("Failed to allocate the MPP frame pool");
+		return false;
+	}
+
+	AVHWFramesContext *frames = (AVHWFramesContext *)enc->hw_frames->data;
+	frames->format = AV_PIX_FMT_DRM_PRIME;
+	frames->sw_format = AV_PIX_FMT_NV12;
+	frames->width = context->width;
+	frames->height = context->height;
+
+	ret = av_hwframe_ctx_init(enc->hw_frames);
+	if (ret < 0) {
+		warn("Failed to initialize the MPP frame pool: %s", av_err2str(ret));
+		return false;
+	}
+
+	context->pix_fmt = AV_PIX_FMT_DRM_PRIME;
+	context->sw_pix_fmt = AV_PIX_FMT_NV12;
+	context->hw_frames_ctx = av_buffer_ref(enc->hw_frames);
+	return context->hw_frames_ctx != NULL;
+}
+
+/* Called inside the graphics context. */
+static struct rkmpp_surface *rkmpp_get_surface(struct rkmpp_encoder *enc, const AVDRMFrameDescriptor *desc)
+{
+	const AVDRMLayerDescriptor *layer = &desc->layers[0];
+	struct rkmpp_surface *surface;
+	int fd = desc->objects[0].fd;
+
+	for (size_t i = 0; i < enc->num_surfaces; i++) {
+		if (enc->surfaces[i].fd == fd)
+			return &enc->surfaces[i];
+	}
+
+	if (enc->num_surfaces == RKMPP_MAX_SURFACES) {
+		warn("Too many frames in flight");
+		return NULL;
+	}
+	if (desc->nb_objects != 1 || desc->nb_layers != 1 || layer->nb_planes != 2) {
+		warn("Unexpected MPP frame layout");
+		return NULL;
+	}
+
+	uint32_t width = (uint32_t)enc->ffve.context->width;
+	uint32_t height = (uint32_t)enc->ffve.context->height;
+	uint64_t modifier = desc->objects[0].format_modifier;
+	static const uint32_t drm_formats[2] = {DRM_FORMAT_R8, DRM_FORMAT_GR88};
+	static const enum gs_color_format gs_formats[2] = {GS_R8, GS_R8G8};
+
+	surface = &enc->surfaces[enc->num_surfaces];
+	surface->fd = fd;
+	for (int p = 0; p < 2; p++) {
+		uint32_t pitch = (uint32_t)layer->planes[p].pitch;
+		uint32_t offset = (uint32_t)layer->planes[p].offset;
+
+		surface->tex[p] = gs_texture_create_from_dmabuf(p ? width / 2 : width, p ? height / 2 : height,
+								drm_formats[p], gs_formats[p], 1, &fd, &pitch,
+								&offset, &modifier);
+		if (!surface->tex[p]) {
+			warn("Failed to import an MPP frame into the GPU");
+			gs_texture_destroy(surface->tex[0]);
+			surface->tex[0] = NULL;
+			return NULL;
+		}
+	}
+
+	enc->num_surfaces++;
+	return surface;
+}
+
+static bool rkmpp_update(struct rkmpp_encoder *enc, obs_data_t *settings)
+{
+	const char *rc = obs_data_get_string(settings, "rate_control");
+	int bitrate = (int)obs_data_get_int(settings, "bitrate");
+	int max_bitrate = (int)obs_data_get_int(settings, "max_bitrate");
+	int cqp = (int)obs_data_get_int(settings, "cqp");
+	int keyint_sec = (int)obs_data_get_int(settings, "keyint_sec");
+	const char *profile = obs_data_get_string(settings, "profile");
+	void *priv = enc->ffve.context->priv_data;
+
+	video_t *video = obs_encoder_video(enc->ffve.encoder);
+	const struct video_output_info *voi = video_output_get_info(video);
+	struct video_scale_info info;
+
+	info.format = voi->format;
+	info.colorspace = voi->colorspace;
+	info.range = voi->range;
+	rkmpp_video_info(enc, &info);
+
+	if (astrcmpi(rc, "CQP") == 0) {
+		bitrate = 0;
+		max_bitrate = 0;
+		av_opt_set(priv, "rc_mode", "CQP", 0);
+		av_opt_set_int(priv, "qp_init", cqp, 0);
+	} else if (astrcmpi(rc, "VBR") == 0) {
+		cqp = 0;
+		if (max_bitrate < bitrate)
+			max_bitrate = bitrate;
+		av_opt_set(priv, "rc_mode", "VBR", 0);
+		enc->ffve.context->rc_max_rate = max_bitrate * INT64_C(1000);
+	} else { /* CBR by default */
+		rc = "CBR";
+		cqp = 0;
+		max_bitrate = bitrate;
+		av_opt_set(priv, "rc_mode", "CBR", 0);
+	}
+
+	if (*profile)
+		av_opt_set(priv, "profile", profile, 0);
+
+	/* 0 = auto; FFmpeg's default GOP of 12 frames is far too short */
+	if (!keyint_sec)
+		keyint_sec = 2;
+
+	const char *ffmpeg_opts = obs_data_get_string(settings, "ffmpeg_opts");
+	ffmpeg_video_encoder_update(&enc->ffve, bitrate, keyint_sec, voi, &info, ffmpeg_opts);
+
+	info("settings:\n"
+	     "\tencoder:      %s\n"
+	     "\tinput:        %s\n"
+	     "\trate_control: %s\n"
+	     "\tbitrate:      %d\n"
+	     "\tmax_bitrate:  %d\n"
+	     "\tcqp:          %d\n"
+	     "\tkeyint:       %d\n"
+	     "\tprofile:      %s\n"
+	     "\twidth:        %d\n"
+	     "\theight:       %d\n"
+	     "\tffmpeg opts:  %s\n",
+	     enc->ffve.enc_name, enc->texture ? "GPU texture (zero-copy)" : "system memory", rc, bitrate, max_bitrate, cqp, enc->ffve.context->gop_size, profile,
+	     enc->ffve.context->width, enc->ffve.height, ffmpeg_opts);
+
+	/* SPS/PPS(/VPS) go into extradata instead of in front of every IDR */
+	enc->ffve.context->flags |= AV_CODEC_FLAG_GLOBAL_HEADER;
+
+	if (enc->texture && !rkmpp_init_hw_frames(enc))
+		return false;
+	if (!ffmpeg_video_encoder_init_codec(&enc->ffve))
+		return false;
+
+	/* rkmpp reports the header size including the zeroed input padding */
+	int size = enc->ffve.context->extradata_size;
+	const uint8_t *extradata = enc->ffve.context->extradata;
+	while (size > 0 && extradata[size - 1] == 0)
+		size--;
+	da_copy_array(enc->header, extradata, size);
+
+	return true;
+}
+
+static void rkmpp_on_init_error(void *data, int ret)
+{
+	struct rkmpp_encoder *enc = data;
+	struct dstr error_message = {0};
+
+	dstr_copy(&error_message, obs_module_text("RKMPP.InitError"));
+	dstr_replace(&error_message, "%1", enc->ffve.enc_name);
+	dstr_replace(&error_message, "%2", av_err2str(ret));
+	obs_encoder_set_last_error(enc->ffve.encoder, error_message.array);
+	dstr_free(&error_message);
+}
+
+static void rkmpp_destroy(void *data)
+{
+	struct rkmpp_encoder *enc = data;
+
+	if (enc->num_surfaces) {
+		obs_enter_graphics();
+		for (size_t i = 0; i < enc->num_surfaces; i++) {
+			gs_texture_destroy(enc->surfaces[i].tex[0]);
+			gs_texture_destroy(enc->surfaces[i].tex[1]);
+		}
+		obs_leave_graphics();
+	}
+
+	ffmpeg_video_encoder_free(&enc->ffve);
+	av_buffer_unref(&enc->hw_frames);
+	da_free(enc->header);
+	bfree(enc);
+}
+
+static void *rkmpp_create_internal(obs_data_t *settings, obs_encoder_t *encoder, enum rkmpp_codec codec,
+				   const char *enc_lib, const char *enc_name, bool texture)
+{
+	video_t *video = obs_encoder_video(encoder);
+	const struct video_output_info *voi = video_output_get_info(video);
+
+	if (voi->colorspace == VIDEO_CS_2100_PQ || voi->colorspace == VIDEO_CS_2100_HLG) {
+		const char *const text = obs_module_text("RKMPP.HdrUnsupported");
+		obs_encoder_set_last_error(encoder, text);
+		blog(LOG_ERROR, "[rkmpp encoder] %s", text);
+		return NULL;
+	}
+
+	struct rkmpp_encoder *enc = bzalloc(sizeof(*enc));
+	enc->codec = codec;
+	enc->texture = texture;
+
+	if (!ffmpeg_video_encoder_init(&enc->ffve, enc, encoder, enc_lib, NULL, enc_name, rkmpp_on_init_error, NULL))
+		goto fail;
+	if (!rkmpp_update(enc, settings))
+		goto fail;
+
+	return enc;
+
+fail:
+	rkmpp_destroy(enc);
+	return NULL;
+}
+
+/* Imports one frame of the pool, so a GPU that can't render into MPP's
+ * buffers falls back to system memory frames before the output starts. */
+static bool rkmpp_test_texture(struct rkmpp_encoder *enc)
+{
+	AVFrame *frame = av_frame_alloc();
+	bool success = false;
+
+	if (frame && av_hwframe_get_buffer(enc->hw_frames, frame, 0) == 0) {
+		obs_enter_graphics();
+		success = rkmpp_get_surface(enc, (const AVDRMFrameDescriptor *)frame->data[0]) != NULL;
+		obs_leave_graphics();
+	}
+	av_frame_free(&frame);
+	return success;
+}
+
+static void *rkmpp_create_tex_internal(obs_data_t *settings, obs_encoder_t *encoder, enum rkmpp_codec codec,
+				       const char *enc_lib, const char *enc_name, const char *fallback)
+{
+	/* OBS only hands out NV12 textures when it renders NV12. */
+	if (obs_encoder_video_tex_active(encoder, VIDEO_FORMAT_NV12)) {
+		struct rkmpp_encoder *enc = rkmpp_create_internal(settings, encoder, codec, enc_lib, enc_name, true);
+		if (enc && rkmpp_test_texture(enc))
+			return enc;
+		if (enc)
+			rkmpp_destroy(enc);
+		if (obs_encoder_get_last_error(encoder))
+			return NULL;
+	}
+
+	blog(LOG_INFO, "[rkmpp encoder] Texture encoding unavailable, using system memory frames");
+	return obs_encoder_create_rerouted(encoder, fallback);
+}
+
+static void *h264_rkmpp_create(obs_data_t *settings, obs_encoder_t *encoder)
+{
+	return rkmpp_create_internal(settings, encoder, RKMPP_CODEC_H264, "h264_rkmpp", "Rockchip MPP H.264", false);
+}
+
+static void *hevc_rkmpp_create(obs_data_t *settings, obs_encoder_t *encoder)
+{
+	return rkmpp_create_internal(settings, encoder, RKMPP_CODEC_HEVC, "hevc_rkmpp", "Rockchip MPP HEVC", false);
+}
+
+static void *h264_rkmpp_create_tex(obs_data_t *settings, obs_encoder_t *encoder)
+{
+	return rkmpp_create_tex_internal(settings, encoder, RKMPP_CODEC_H264, "h264_rkmpp", "Rockchip MPP H.264",
+					 "ffmpeg_rkmpp_h264_soft");
+}
+
+static void *hevc_rkmpp_create_tex(obs_data_t *settings, obs_encoder_t *encoder)
+{
+	return rkmpp_create_tex_internal(settings, encoder, RKMPP_CODEC_HEVC, "hevc_rkmpp", "Rockchip MPP HEVC",
+					 "ffmpeg_rkmpp_hevc_soft");
+}
+
+static bool rkmpp_encode(void *data, struct encoder_frame *frame, struct encoder_packet *packet,
+			 bool *received_packet)
+{
+	struct rkmpp_encoder *enc = data;
+	return ffmpeg_video_encode(&enc->ffve, frame, packet, received_packet);
+}
+
+/* Mesa copies into imported linear buffers on the CPU (gs_copy_texture takes
+ * ~20 ms per 4K frame on Panthor), so draw the plane instead. Called inside
+ * the graphics context. */
+static void rkmpp_draw_plane(gs_texture_t *dst, gs_texture_t *src)
+{
+	gs_effect_t *effect = obs_get_base_effect(OBS_EFFECT_DEFAULT);
+	gs_eparam_t *image = gs_effect_get_param_by_name(effect, "image");
+	uint32_t width = gs_texture_get_width(dst);
+	uint32_t height = gs_texture_get_height(dst);
+	gs_texture_t *prev_target = gs_get_render_target();
+	gs_zstencil_t *prev_zs = gs_get_zstencil_target();
+	const bool prev_srgb = gs_framebuffer_srgb_enabled();
+
+	gs_viewport_push();
+	gs_projection_push();
+	gs_blend_state_push();
+	gs_enable_framebuffer_srgb(false);
+	gs_enable_blending(false);
+	gs_set_render_target(dst, NULL);
+	gs_set_viewport(0, 0, (int)width, (int)height);
+	gs_ortho(0.0f, (float)width, 0.0f, (float)height, -100.0f, 100.0f);
+
+	gs_effect_set_texture(image, src);
+	while (gs_effect_loop(effect, "Draw"))
+		gs_draw_sprite(src, 0, width, height);
+
+	gs_set_render_target(prev_target, prev_zs);
+	gs_enable_framebuffer_srgb(prev_srgb);
+	gs_blend_state_pop();
+	gs_projection_pop();
+	gs_viewport_pop();
+}
+
+static bool rkmpp_encode_tex(void *data, struct encoder_texture *texture, int64_t pts, uint64_t lock_key,
+			     uint64_t *next_key, struct encoder_packet *packet, bool *received_packet)
+{
+	UNUSED_PARAMETER(lock_key);
+	UNUSED_PARAMETER(next_key);
+
+	struct rkmpp_encoder *enc = data;
+	struct rkmpp_surface *surface = NULL;
+	EGLDisplay display = EGL_NO_DISPLAY;
+	EGLSync sync = EGL_NO_SYNC;
+	AVFrame *frame;
+	bool success = false;
+	int ret;
+
+	*received_packet = false;
+
+	frame = av_frame_alloc();
+	if (!frame)
+		return false;
+	ret = av_hwframe_get_buffer(enc->hw_frames, frame, 0);
+	if (ret < 0) {
+		warn("Failed to get an MPP frame: %s", av_err2str(ret));
+		goto out;
+	}
+
+	obs_enter_graphics();
+	if (texture->tex[0] && texture->tex[1])
+		surface = rkmpp_get_surface(enc, (const AVDRMFrameDescriptor *)frame->data[0]);
+	if (surface) {
+		rkmpp_draw_plane(surface->tex[0], texture->tex[0]);
+		rkmpp_draw_plane(surface->tex[1], texture->tex[1]);
+		display = eglGetCurrentDisplay();
+		sync = eglCreateSync(display, EGL_SYNC_FENCE, NULL);
+		gs_flush();
+	}
+	obs_leave_graphics();
+
+	if (!surface)
+		goto out;
+
+	/* MPP reads the buffer as soon as it gets the frame and doesn't wait for
+	 * the GPU, so wait here, outside the graphics lock. */
+	if (sync != EGL_NO_SYNC) {
+		eglClientWaitSync(display, sync, 0, 1000000000);
+		eglDestroySync(display, sync);
+	} else if (!enc->sync_warned) {
+		warn("Unable to create a GPU fence; frames may tear");
+		enc->sync_warned = true;
+	}
+
+	av_frame_copy_props(frame, enc->ffve.vframe);
+	frame->pts = pts;
+	success = ffmpeg_video_encode_avframe(&enc->ffve, frame, packet, received_packet);
+
+out:
+	av_frame_free(&frame);
+	return success;
+}
+
+static void rkmpp_defaults_internal(obs_data_t *settings, const char *profile)
+{
+	obs_data_set_default_string(settings, "rate_control", "CBR");
+	obs_data_set_default_int(settings, "bitrate", 6000);
+	obs_data_set_default_int(settings, "max_bitrate", 9000);
+	obs_data_set_default_int(settings, "cqp", 23);
+	obs_data_set_default_int(settings, "keyint_sec", 0);
+	obs_data_set_default_string(settings, "profile", profile);
+}
+
+static void h264_rkmpp_defaults(obs_data_t *settings)
+{
+	rkmpp_defaults_internal(settings, "high");
+}
+
+static void hevc_rkmpp_defaults(obs_data_t *settings)
+{
+	rkmpp_defaults_internal(settings, "main");
+}
+
+static bool rate_control_modified(obs_properties_t *ppts, obs_property_t *p, obs_data_t *settings)
+{
+	const char *rc = obs_data_get_string(settings, "rate_control");
+	bool cqp = astrcmpi(rc, "CQP") == 0;
+	bool vbr = astrcmpi(rc, "VBR") == 0;
+
+	p = obs_properties_get(ppts, "bitrate");
+	obs_property_set_visible(p, !cqp);
+	p = obs_properties_get(ppts, "max_bitrate");
+	obs_property_set_visible(p, vbr);
+	p = obs_properties_get(ppts, "cqp");
+	obs_property_set_visible(p, cqp);
+
+	return true;
+}
+
+static obs_properties_t *rkmpp_properties_internal(enum rkmpp_codec codec)
+{
+	obs_properties_t *props = obs_properties_create();
+	obs_property_t *p;
+
+	p = obs_properties_add_list(props, "rate_control", obs_module_text("RateControl"), OBS_COMBO_TYPE_LIST,
+				    OBS_COMBO_FORMAT_STRING);
+	obs_property_list_add_string(p, "CBR", "CBR");
+	obs_property_list_add_string(p, "VBR", "VBR");
+	obs_property_list_add_string(p, "CQP", "CQP");
+	obs_property_set_modified_callback(p, rate_control_modified);
+
+	p = obs_properties_add_int(props, "bitrate", obs_module_text("Bitrate"), 50, 300000, 50);
+	obs_property_int_set_suffix(p, " Kbps");
+
+	p = obs_properties_add_int(props, "max_bitrate", obs_module_text("MaxBitrate"), 50, 300000, 50);
+	obs_property_int_set_suffix(p, " Kbps");
+
+	obs_properties_add_int(props, "cqp", "QP", 1, 51, 1);
+
+	p = obs_properties_add_int(props, "keyint_sec", obs_module_text("KeyframeIntervalSec"), 0, 10, 1);
+	obs_property_int_set_suffix(p, " s");
+
+	p = obs_properties_add_list(props, "profile", obs_module_text("Profile"), OBS_COMBO_TYPE_LIST,
+				    OBS_COMBO_FORMAT_STRING);
+	if (codec == RKMPP_CODEC_H264) {
+		obs_property_list_add_string(p, "high", "high");
+		obs_property_list_add_string(p, "main", "main");
+		obs_property_list_add_string(p, "baseline", "baseline");
+	} else {
+		obs_property_list_add_string(p, "main", "main");
+	}
+
+	obs_properties_add_text(props, "ffmpeg_opts", obs_module_text("FFmpegOpts"), OBS_TEXT_DEFAULT);
+
+	return props;
+}
+
+static obs_properties_t *h264_rkmpp_properties(void *unused)
+{
+	UNUSED_PARAMETER(unused);
+	return rkmpp_properties_internal(RKMPP_CODEC_H264);
+}
+
+static obs_properties_t *hevc_rkmpp_properties(void *unused)
+{
+	UNUSED_PARAMETER(unused);
+	return rkmpp_properties_internal(RKMPP_CODEC_HEVC);
+}
+
+static bool rkmpp_extra_data(void *data, uint8_t **extra_data, size_t *size)
+{
+	struct rkmpp_encoder *enc = data;
+
+	*extra_data = enc->header.array;
+	*size = enc->header.num;
+	return true;
+}
